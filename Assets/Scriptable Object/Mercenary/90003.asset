  MercName: "\uB9AC\uC2DC\uC548\uC758 \uAC80, \uBA5C\uB9AC\uC81C"
  Description: "\uAE30\uC0AC\uC600\uB358 \uC5B4\uBA38\uB2C8\uAED8 \uBC1B\uC740 \uAC80\uC744
    \uC5B4\uB9B4 \uC801\uBD80\uD130 \uBAB8\uC5D0\uC11C \uB5BC\uB193\uC9C0 \uC54A\uACE0
    \uC77C\uD3C9\uC0DD\uC744 \uAC80\uC744 \uB2E8\uB828\uD558\uBA70 \uC0B4\uC558\uB358
    \uADF8\uB140\uB294 \uC544\uC9C1 \uC80A\uC740 \uB098\uC774\uC784\uC5D0\uB3C4 \uB300\uB959\uC758
    \uC218 \uB9CE\uC740 \uAC80\uC0AC\uB4E4\uC5D0\uAC8C \uB2A5\uB825\uC744 \uC778\uC815\uBC1B\uC558\uB2E4.\n\uB9AC\uC2DC\uC548\uC758
    \uC6A9\uBCD1\uC73C\uB85C\uC11C \uCC38\uC804\uD588\uB358 \uC804\uD22C\uC5D0\uC11C
    \uC218\uB9CE\uC740 \uBB34\uACF5\uC744 \uC313\uC544 '\uB9AC\uC2DC\uC548\uC758
    \uAC80'\uC774\uB77C\uB294 \uC601\uAD11\uC2A4\uB7EC\uC6B4 \uCE6D\uD638\uB97C \uBC1B\uC558\uB2E4."
