  m_Name: 50004
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_NPCData
  npcName: "\uC120\uC220\uC9D1 \uC8FC\uC778"
  npcFriendlyName: "\uC120\uC220\uC9D1 \uC8FC\uC778, \uBCF4\uB9AC\uC2A4"
  dialogues:
  - {fileID: 11400000, guid: efa46669aeb8c79449df75994b99443b, type: 2}
  - {fileID: 11400000, guid: 0013b7d994d5bb44a9cee18097ec3d1b, type: 2}
  - {fileID: 11400000, guid: 05fe0c6ab2f73a844b54a5eee5ee4605, type: 2}
  - {fileID: 11400000, guid: 58862f62a8a37a543879af9831cf2587, type: 2}
  - {fileID: 11400000, guid: 8b3b33983717a2642b5abc43bec8f132, type: 2}
  - {fileID: 11400000, guid: 78a2e9cd319de2147a9f9b8da63bbc83, type: 2}
  preferGift: 
  memo: "\uC120\uC220\uC9D1 \uC138\uC158\uC5D0\uC11C \uBCFC \uC218 \uC788\uB294 NPC\uB85C
    \uBA5C\uB9AC\uC544\uC758 \uB0A8\uD3B8\uC774\uB2E4. \uB300\uBD80\uBD84\uC758 \uACBD\uC6B0
    \uB4F1\uC7A5\uD55C\uB2E4. \uD638\uD0D5\uD55C \uAD34\uB825\uAC00. \uC9D1\uC548
    \uC790\uCCB4\uAC00 \uC804\uC0AC\uC9D1\uC548\uC774\uB2E4. \uD5D8\uC545\uD558\uAC8C
    \uC0DD\uACBC\uC9C0\uB9CC \uC0AC\uC2E4 \uC18D\uC740 \uC5EC\uB9AC\uACE0 \uC9D1\uC548\uB0B4
    \uCD5C\uACE0\uC758 \uC7AC\uB2A5\uC73C\uB85C \uAF3D\uD788\uC9C0\uB9CC \uAD34\uBB3C\uB4E4\uC774
    \uBB34\uC11C\uC6CC\uC11C \uB358\uC804\uC744 \uAC00\uAC70\uB098 \uD558\uC9C0\uB294
    \uBABB\uD558\uACE0 \uB9C8\uC744 \uACBD\uBE44\uBCD1\uC73C\uB85C \uC7A0\uAE50 \uC9C0\uB0C8\uB2E4.
    \uADF8\uC758 \uD5D8\uC545\uD55C \uC778\uC0C1\uC740 \uC9C4\uC0C1\uB4E4\uC744 \uCAD2\uC544\uB0B4\uB294\uB370
    \uB9E4\uC6B0 \uC720\uC6A9\uD558\uB2E4. \uC544\uB0B4\uC640 \uB2EC\uB9AC \uD5D8\uC545\uD558\uC9C0\uB9CC
    \uC758\uC678\uB85C \uC544\uB0B4\uAC00 \uBA3C\uC800 \uACE0\uBC31\uD55C \uC5F0\uC560
    \uACB0\uD63C\uC774\uB77C\uACE0 \uD55C\uB2E4. \uD5D8\uC545\uD558\uAC8C \uC0DD\uACBC\uC9C0\uB9CC
    \uC12C\uC138\uD55C \uBCF4\uB9AC\uC2A4\uC5D0\uAC8C \uBC18\uD588\uB2E4\uB294 \uB4EF.
    \uC544\uC774\uB4E4\uC744 \uC88B\uC544\uD558\uBA70 \uAE30\uBD80\uB3C4 \uB9CE\uC774
    \uD558\uB294 \uB4F1 \uC120\uD589\uC744 \uB9CE\uC774 \uBCA0\uD47C\uB2E4.\r\n\uBA5C\uB9AC\uC544\uC640
    \uACF5\uC720\uD558\uB294 \uC120\uC220\uC9D1 \uC8FC\uC778\uC73C\uB85C\uC11C\uC758
    \uD638\uAC10\uB3C4\uAC00 \uC788\uC73C\uBA70 \uBCF4\uB9AC\uC2A4 \uAC1C\uC778\uC73C\uB85C\uC11C\uC758
    \uD638\uAC10\uB3C4\uAC00 \uB098\uB258\uC5B4\uC788\uB2E4.\r\n\uC120\uC220\uC9D1
    \uC8FC\uC778\uC73C\uB85C\uC11C\uC758 \uD638\uAC10\uB3C4\uAC00 \uB192\uB2E4\uBA74
    \uD55C \uD131 \uB0BC \uB54C, \uAC04\uD639 \uC18C\uBB38 \uC220\uC794\uC774 \uAC10\uC18C\uD558\uC9C0
    \uC54A\uB294\uB2E4. \uB610\uD55C \uBC1C\uC8FC\uC640 \uC218\uC8FC \uAC00\uB2A5\uD55C
    \uD018\uC2A4\uD2B8\uC758 \uC218\uAC00 \uB298\uC5B4\uB09C\uB2E4.\r\n\uBCF4\uB9AC\uC2A4\uB85C\uC11C\uC758
    \uD638\uAC10\uB3C4\uAC00 \uB192\uB2E4\uBA74 \uC6A9\uBCD1\uB4E4\uC758 \uACF5\uACA9\uB825\uACFC
    \uBC29\uC5B4\uB825\uC774 \uB192\uC544\uC9C4\uB2E4. \uC81C\uC791 \uB300\uAE30\uB97C
    \uAC78\uC5B4\uB193\uC740 \uB808\uC2DC\uD53C\uAC00 \uC788\uB2E4\uBA74 \uAC00\uB054
    \uBD80\uC871\uD55C \uC7AC\uB8CC\uB97C \uC54C\uACE0 \uC120\uBB3C\uD558\uAC70\uB098
    \uC694\uAD6C\uB418\uB294 \uC7AC\uB8CC\uB97C \uC120\uBB3C\uD55C\uB2E4.\r\n\uCD5C\uB300
    \uD638\uAC10\uB3C4\uC778 \uACBD\uC6B0 \"\uBD84\uC1C4\uC790(\uC544\u7259)\" \uC81C\uC791\uBC95\uC744
    \uC5BB\uC744 \uC218 \uC788\uB2E4. \uC9D1\uC5D0\uC11C \uB300\uB300\uB85C \uB0B4\uB824\uC624\uB294
    \uAC00\uBCF4 \"\uBCC4 \uBD84\uC1C4\uC790\"\uC744 \uC704\uD574 \uD544\uC694\uD558\uB2E4\uB294\uB370
    \uB098\uBA38\uC9C0 2\uAC1C\uB294 \uC5B4\uB528\uB294\uC9C0 \uBAA8\uB978\uB2E4\uACE0
    \uD55C\uB2E4."
