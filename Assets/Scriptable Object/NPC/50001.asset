  m_Name: 50001
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_NPCData
  npcName: "\uD3EC\uB974\uD14C"
  npcFriendlyName: "\uD3EC\uB974\uD14C"
  dialogues:
  - {fileID: 11400000, guid: 0d570e2454b36b44fa4748b7e6af4eb6, type: 2}
  - {fileID: 11400000, guid: 27102ad9230f7f146952530836d3ca65, type: 2}
  preferGift: 
  memo: "\uD0DC\uC5B4\uB098 \uCC98\uC74C \uB208\uB730\uB54C \uBCF8 \uAC83\uC740 \uB2F9\uC2E0\uC758
    \uD615 \uD3EC\uB974\uD14C. \uCC29\uD558\uACE0 \uC131\uC2E4\uD558\uBA70 \uC6A9\uAC10\uD558\uB2E4.
    \uADF8\uC57C\uB9D0\uB85C \uC804\uD615\uC801\uC778 \uC6A9\uC0AC\uC758 \uADC0\uAC10.
    \uD558\uC9C0\uB9CC \uC57D\uD558\uB2E4. \uB2F9\uC5F0\uD788 \uC77C\uBC18\uC778\uBCF4\uB2E4\uC57C
    \uC384\uC9C0\uB9CC C\uAE09 \uCD5C\uD558\uC704 \uBAA8\uD5D8\uAC00\uB2E4. \uB2F9\uC2E0\uACFC
    \uAC00\uC871\uC744 \uC18C\uC911\uD788 \uC5EC\uAE30\uACE0 \uB2F9\uC2E0\uC758 \uBD80\uD0C1\uC774\uB77C\uBA74
    \uB3C8\uC744 \uBC1B\uC9C0\uB3C4 \uC54A\uACE0 \uADF8\uB0E5 \uC77C\uB2E8 \uB3C4\uC6B0\uB824\uACE0
    \uD55C\uB2E4. \uB2F9\uC2E0\uC740 \uBE44\uC988\uB2C8\uC2A4\uC801\uC778 \uB9C8\uC778\uB4DC\uB85C
    \uB3C8\uC744 \uC9C0\uBD88\uD55C\uB2E4. \uD615\uC740 \uC790\uC2E0\uC758 \uCD5C\uC18C\uD55C\uC758
    \uB3C8\uB9CC\uC744 \uB0A8\uAE30\uACE0 \uC804\uBD80 \uAE30\uBD80\uD55C\uB2E4.(\uC2E4\uC81C\uB85C
    \uD3EC\uB974\uD14C\uC758 \uACBD\uC6B0 \uD018\uC2A4\uD2B8 \uBE44\uC6A9 \uC9C0\uBD88\uC774
    \uC544\uB2C8\uB77C `\uBE48\uBBFC\uAC00 \uBB34\uB8CC \uC9C4\uB8CC\uC18C\uC5D0
    \uAE30\uBD80` \uB4F1\uC73C\uB85C \uB72C\uB2E4)\r\n\uB610\uD55C \uD3EC\uB974\uD14C\uB294
    `\uC120\uD589\uACFC \uBCF4\uC740`\uC774\uB77C\uB294 \uD328\uC2DC\uBE0C \uC2A4\uD0AC\uC744
    \uAC16\uACE0 \uC788\uC5B4 \uD76C\uADC0 \uC7AC\uB8CC\uB098 \uB3C8\uC744 \uB354
    \uB9CE\uC774 \uBC8C\uC5B4\uB4E4\uC77C \uC218 \uC788\uB2E4. \uB610\uD55C \uC131\uC7A5\uD560
    \uB54C\uB9C8\uB2E4 `\uC740\uD61C \uC785\uC740 \uC790\uB4E4\uC758 \uAC00\uD638`\uB77C\uB294
    \uC2A4\uD0AC\uC774 \uD568\uAED8 \uC131\uC7A5\uD558\uACE0 \uD574\uB2F9 \uC2A4\uD0AC\uC758
    \uD6A8\uACFC\uC778 \uB9C8\uB825 \uC99D\uAC00\uAC00 \uD070\uD3ED\uC73C\uB85C \uC0C1\uC2B9\uD55C\uB2E4.\r\n\uD558\uC9C0\uB9CC
    \uD3EC\uB974\uD14C\uB294 \uBC8C\uC5B4\uB4E4\uC774\uB294 \uAE08\uC561\uC758 \uB300\uBD80\uBD84\uC744
    \uAE30\uBD80\uD558\uAE30 \uB54C\uBB38\uC5D0 \uD50C\uB808\uC774\uC5B4\uAC00 \uB358\uC804\uC73C\uB85C
    \uBC8C\uC5B4\uB4E4\uC774\uB294 \uB3C8\uC774 \uB298\uC5B4\uB098\uB294 \uC815\uB3C4\uC758
    \uD6A8\uACFC\uBFD0\uC774\uB2E4. \uADF8\uB9AC\uACE0 `\uC740\uD61C \uC785\uC740
    \uC790\uB4E4\uC758 \uAC00\uD638`\uC2A4\uD0AC\uB85C \uB9C8\uB825\uC740 \uD06C\uAC8C
    \uC131\uC7A5\uD558\uC9C0\uB9CC \uC815\uC791 \uD3EC\uB974\uD14C\uB294 \uB9C8\uBC95\uC11C\uB098
    \uC9C0\uD321\uC774\uC758 \uC801\uC131\uC774 \uC5C6\uC5B4 \uB9C8\uBC95\uAC80\uACFC
    \uAC19\uC740 \uD55C\uC815\uC801\uC778 \uB9C8\uBC95\uACC4\uC5F4 \uBB34\uAE30\uB97C
    \uC0AC\uC6A9\uD574\uC57C\uD55C\uB2E4. \uB2E4\uB9CC \uD3EC\uB974\uD14C\uB294 \uC2A4\uD0EF\uC774
    \uACE8\uACE0\uB8E8 \uC798 \uC131\uC7A5\uD558\uB294 \uCE90\uB9AD\uD130.\r\n\uB9C8\uC744\uC758
    \uBD88\uB7C9\uBC30\uB294 \uD3EC\uB974\uD14C\uAC00 \uB300\uBD80\uBD84 \uBD99\uC7A1\uC544
    \uAC10\uD654\uC2DC\uCF30\uAE30\uC5D0 \uB9C8\uC744 \uCE58\uC548\uC774 \uAD49\uC7A5\uD788
    \uC88B\uC740 \uD3B8\uC774\uB2E4. \uADF8\uB807\uAE30\uC5D0 \uC778\uB9DD\uB3C4
    \uB450\uD130\uC6B4 \uD3B8. \uB2F9\uC2E0\uC758 \uBAA8\uD5D8\uAC00 \uC801\uC131\uC774(\uC7A0\uC7AC\uC218\uCE58)
    \uBAA8\uB450 \uCD5C\uB300 \uC218\uCE58(\uC6A9\uC0AC \uD6C4\uBCF4)\uB85C \uB098\uC654\uC74C\uC5D0\uB3C4
    \uB9CE\uC740 \uC0AC\uB78C\uB4E4\uC774 \uB2F9\uC2E0\uC744 \uBAA8\uD5D8\uAC00\uB85C,
    \uC6A9\uC0AC\uB85C\uC11C \uC0AC\uBA85\uC744 \uB2E4\uD574\uC57C\uD55C\uB2E4\uACE0
    \uB9D0\uD560 \uB54C, \uB2F9\uC2E0\uC758 \uC758\uACAC\uC744 \uAD7D\uD788\uC9C0
    \uC54A\uACE0 \uC6D0\uD558\uB294 \uB300\uB85C \uC0B4 \uC218 \uC788\uB294 \uAC83\uC740
    \uD3EC\uB974\uD14C\uAC00 \uB3D9\uC0DD\uC778 \uB2F9\uC2E0\uC744 \uC9C0\uC9C0\uD588\uAE30
    \uB54C\uBB38\uC778 \uAC83\uB3C4 \uC788\uB2E4.\r\n\uD638\uAC10\uB3C4 \uC218\uCE58\uB294
    \uB530\uB85C \uC874\uC7AC\uD558\uC9C0 \uC54A\uB294\uB2E4."
