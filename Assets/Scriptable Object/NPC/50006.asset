  npcName: "\uC120\uC220\uC9D1 \uC544\uB4E4"
  npcFriendlyName: "\uC120\uC220\uC9D1 \uC544\uB4E4, \uD638\uB8EC"
  dialogues:
  - {fileID: 11400000, guid: 94d2bf366a05f3f439fe5fed64590e90, type: 2}
  - {fileID: 11400000, guid: 5d303f47908902f4b9811709a8a43ba8, type: 2}
  - {fileID: 11400000, guid: b37626c9ec45cfd4a88e9352900f398d, type: 2}
  - {fileID: 11400000, guid: fc967496900fdc944b9b9b10293d376e, type: 2}
  - {fileID: 11400000, guid: b283537e0a6df674ebee5c8ceb6135da, type: 2}
  - {fileID: 11400000, guid: 9d713bdfb6915574986572950924f70f, type: 2}
  preferGift: 
  memo: "\uC120\uC220\uC9D1 \uBD80\uBD80\uC758 \uD638\uAC10\uB3C4\uAC00 \uC801\uC815\uC774\uC0C1\uC77C
    \uB54C \uC0C1\uC810\uAC00\uC5D0\uC11C \uAC04\uD639 \uB9CC\uB0A0 \uC218 \uC788\uB2E4.
    \uB2E4\uD589\uD788 \uC544\uB0B4\uC778 \uBA5C\uB9AC\uC544\uB97C \uC774\uC058\uC7A5\uD55C
    \uC5BC\uAD74\uC744 \uAC00\uC84C\uB2E4. \uC9D1\uC548\uC758 \uAC00\uBCF4 \"\uBD84\uC1C4\uC790(\uC9C4)\"\uC744
    \uB4E4\uACE0 \uAC15\uD55C \uC801\uB4E4\uC744 \uBB34\uCC0C\uB974\uACA0\uB2E4\uB294
    \uC9C4\uC9C0\uD55C \uBAA9\uD45C\uB97C \uAC00\uC84C\uB2E4. \uC5B4\uB824\uC11C
    \uC5F0\uC560\uAC10\uC815 \uAC19\uC740 \uAC74 \uBAA8\uB974\uC9C0\uB9CC \uC0D0\uB9AC\uC5D0\uAC8C
    \uD638\uAC10\uC774 \uC788\uB294 \uB4EF. \uC544\uBC84\uC9C0 \uBCF4\uB9AC\uC2A4
    \uC9D1\uC548\uC758 \uAD34\uB825\uC744 \uAC00\uC838 \uC5B4\uB9B0\uB370\uB3C4 \uAC70\uB300\uD55C
    \uBC14\uC704\uB97C \uB4E4\uAC70\uB098 \uB179\uC2A8 \uACE8\uB818\uC744 \uB2E8\uC2E0\uC73C\uB85C
    \uCC98\uCE58\uD558\uB294 \uB4F1 \uB0A8\uB2E4\uB978 \uC804\uC0AC\uB85C\uC11C\uC758
    \uC790\uC9C8\uC744 \uBCF4\uC5EC\uC900\uB2E4. \uAC00\uBCF4\uC778 \uBCC4 \uBD84\uC1C4\uC790\uB97C
    \uC544\uBE60 \uBAB0\uB77C \uAEBC\uB0B4\uC11C \uB4E4\uC5B4\uBD24\uB294\uB370 \uBCF8\uC778
    \uB9D0\uB85C\uB294 \uD55C\uC190\uC740 \uC544\uC9C1 \uD798\uB4E4\uC9C0\uB9CC \uB450
    \uC190\uC73C\uB85C\uB294 \uB4E4\uACE0 \uD718\uB450\uB97C \uC218\uB3C4 \uC788\uB2E4\uACE0.\r\n\uD2B9\uC815
    \uD018\uC2A4\uD2B8\uC5D0 \uD55C\uC815\uD558\uC5EC \uC6A9\uBCD1\uC73C\uB85C \uACE0\uC6A9\uC774
    \uAC00\uB2A5\uD558\uBA70 \uBB34\uAE30\uB294 \uD22C\uBC15\uD55C \uB300\uD615\uB9DD\uCE58
    \uBC18\uB4DC\uC2DC B\uAE09 \uC774\uC0C1\uC758 \uC6A9\uBCD1\uC774 \uB3D9\uBC18\uB418\uC5B4\uC57C
    \uD55C\uB2E4. \uCCB4\uB825\uC218\uCE58\uB294 C\uAE09 \uC6A9\uBCD1\uBCF4\uB2E4
    \uC870\uAE08 \uB0AE\uC9C0\uB9CC \uACF5\uACA9\uB825\uC740 B\uAE09 \uC6A9\uBCD1\uC5D0\uC11C\uB3C4
    \uAF64 \uB192\uC740 \uCD95\uC5D0 \uC18D\uD55C\uB2E4.\r\n\uD638\uAC10\uB3C4\uAC00
    \uB192\uC744 \uACBD\uC6B0 \uC6A9\uBCD1\uB4E4\uC758 \uCD5C\uB300\uCCB4\uB825\uC774
    \uB192\uC544\uC9C4\uB2E4.\r\n\uD638\uAC10\uB3C4\uAC00 \uCD5C\uB300\uC77C \uACBD\uC6B0
    \"\uBD84\uC1C4\uC790(\uAD11\u72C2)\" \uC81C\uC791\uBC95\uC744 \uC5BB\uC744 \uC218
    \uC788\uB2E4. \uBCF4\uB9AC\uC2A4\uAC00 \uD638\uB8EC\uACFC \uBB3C\uAC74\uB4E4\uC744
    \uC815\uB9AC\uD560 \uB54C \uC81C\uB300\uB85C \uD655\uC778\uC744 \uC548\uD574\uC11C
    \uD544\uC694\uC5C6\uB2E4\uACE0 \uD574\uC11C \uD638\uB8EC\uC774 \uBE44\uBC00\uAE30\uC9C0
    \uBCF4\uBB3C\uC0C1\uC790\uC5D0 \uB123\uC5B4\uB1A8\uB2E4\uACE0 \uD55C\uB2E4."
