  npcName: "\uC6A9\uBCD1 \uAD00\uB9AC\uC778"
  npcFriendlyName: "\uC6A9\uBCD1 \uAD00\uB9AC\uC778, \uC18C\uD53C\uC544"
  dialogues:
  - {fileID: 11400000, guid: 473a039f77d231f41be9b80954b976af, type: 2}
  - {fileID: 11400000, guid: 3f89001557c17d24c9989abd482dfc62, type: 2}
  - {fileID: 11400000, guid: 2fc3742720b48914cbd5e4329edc9750, type: 2}
  - {fileID: 11400000, guid: 875856ae5e6c12e4dbd877ff3059f44f, type: 2}
  - {fileID: 11400000, guid: a57adae4b7fa7f34489ce34493fdb639, type: 2}
  - {fileID: 11400000, guid: 62fe6da0ba446334b9663d5d9589616f, type: 2}
  preferGift: 
  memo: "\uB2E4\uC18C \uBB34\uB69D\uB69D\uD558\uACE0 \uCC28\uAC00\uC6B4 \uC131\uACA9.
    4\uB0A8 1\uB140 \uC9D1\uC548\uC758 \uC14B\uC9F8. \uD604\uC7AC\uB294 \uAC00\uC871
    \uBD80\uC591\uC744 \uC704\uD574 \uC548\uC804\uBB38\uC81C\uB85C \uC6A9\uBCD1 \uAD00\uB9AC\uC778\uC73C\uB85C
    \uC77C\uD558\uACE0 \uC788\uC9C0\uB9CC, \uBCF8\uB798 \uC6A9\uBCD1\uC73C\uB85C
    \uC77C\uD560 \uB54C\uB294 \uB9E4\uC6B0 \uB192\uC740 \uBA85\uC131\uC744 \uC9C0\uB154\uB2E4.
    \uB9CE\uC740 \uC6A9\uBCD1\uB4E4\uC740 \uACE0\uC9D1\uB3C4 \uAC15\uD558\uACE0 \uC8FC\uC7A5\uB3C4
    \uAC70\uC140\uD150\uB370, \uADF8\uB140\uC758 \uC774\uC57C\uAE30\uC5D0\uB294 \uB298
    \uC800\uD56D\uD558\uC9C0 \uC54A\uACE0 \uB530\uB974\uB294 \uAC83\uC774 \uC628\uC804\uD788
    \uC6A9\uBCD1\uB4E4\uC774 \uC720\uC21C\uD558\uACE0 \uCC29\uD574\uC11C\uB77C\uB294
    \uC774\uC720\uB294 \uC544\uB2D0 \uAC83\uC774\uB2E4. \uC0DD\uAC01\uBCF4\uB2E4
    \uC815\uC774 \uB9CE\uB2E4. \uAC70\uBD81\uC774\uB97C \uD0A4\uC6B0\uACE0 \uC788\uB2E4.
    \uAC70\uBD81\uC774 \uC774\uB984\uC740 \uCF54\uCF54. \uC758\uC678\uB85C \uB0B4\uBA74\uC740
    \uC5F0\uC57D\uD55C\uB4EF.\r\n\uD638\uAC10\uB3C4\uAC00 \uB192\uB2E4\uBA74 \uB192\uC740
    \uC218\uC900\uC758 \uC6A9\uBCD1\uC744 \uACE0\uC6A9\uD560 \uC218 \uC788\uB2E4.
    \uB610\uD55C \uACE0\uC6A9 \uC9C4\uD589 \uC911\uC5D0 \uBE44\uC6A9 \uCC45\uC815\uC5D0\uC11C
    \uD638\uAC10\uB3C4\uAC00 \uB192\uC744\uC2DC \uADF8\uB140\uAC00 \uC885\uC885 \uAC1C\uC785\uD574\uC11C
    \uACC4\uC57D\uC744 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC720\uB9AC\uD558\uAC8C
    \uC9C4\uD589\uD558\uB3C4\uB85D \uB3D5\uB294 \uBAA8\uC2B5\uC744 \uBCFC \uC218
    \uC788\uB2E4. \uC774\uC678\uC5D0\uB3C4 \uD018\uC2A4\uD2B8\uC758 \uBC1C\uC8FC\uB97C
    \uD560 \uB54C \uD638\uAC10\uB3C4\uAC00 \uC5B4\uB290\uC815\uB3C4 \uC788\uB2E4\uBA74
    \uC758\uB8B0 \uBC1C\uC8FC \uB09C\uC774\uB3C4\uB97C \uCC45\uC815\uD558\uB294\uB370
    \uB3C4\uC6C0\uC744 \uC900\uB2E4.\r\n\uCD5C\uB300 \uD638\uAC10\uB3C4\uC778 \uACBD\uC6B0
    \"\uC218\uB77C\uC758 \uBD89\uC740 \uACE1\uAD81\" \uC81C\uC791\uBC95\uC744 \uC5BB\uC744
    \uC218 \uC788\uB2E4. \uC18C\uD53C\uC544\uC5D0\uAC8C \uBCF4\uC5EC\uC8FC\uBA74
    \uC790\uC2E0\uC774 \uC0AC\uC6A9\uD558\uB358 \uD65C(\uC560\uCE6D \uB098\uB098)\uACFC
    \uB611\uAC19\uC774 \uC0DD\uACBC\uB2E4\uACE0 \uB180\uB78C.\r\n\uAE30\uB2A5 \uD14C\uC2A4\uD2B8\uC6A9
    \uC6A9\uBCD1\uC73C\uB85C \uC0AC\uC6A9\uB420 \uC608\uC815, \uC6A9\uBCD1\uC73C\uB85C\uC11C\uC758
    \uC801\uC131\uC740 \uBAA8\uB4E0 \uBB34\uAE30\uB97C \uB2E4\uB8F0 \uC218 \uC788\uB2E4."
