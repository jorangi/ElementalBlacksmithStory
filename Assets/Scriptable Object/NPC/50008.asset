  - {fileID: 11400000, guid: c60567aa11af4a64a8c5b92ba66c3164, type: 2}
  preferGift: 
  memo: "# <\uC7A5\uBE44\uC810\uC758 \uC8FC\uC778, \uCE90\uB864\uB77C\uC778>\r\n\r\n30\uB300
    \uCD08\uBC18\uC758 \uC5EC\uC131. \uC655\uB3C4\uC5D0\uC11C \uC794\uBF08\uAC00
    \uAD75\uC740 \uAC10\uC815\uC0AC \uCD9C\uC2E0. \uC190\uC5D0 \uC954 \uBB3C\uAC74\uC758
    \uAC12\uC5B4\uCE58\uB97C \uC7AC\uB294 \uB370\uB294 \uB3C4\uAC00 \uD144\uC9C0\uB9CC,
    \uC815\uC791 \uC790\uAE30 \uC778\uC0DD\uC758 \uAC12\uC5B4\uCE58\uB97C \uC7AC\uB294
    \uB370\uB294 \uBCC4\uB85C \uAD00\uC2EC\uC774 \uC5C6\uC5C8\uB358 \uC0AC\uB78C
    \u2014 \uC5B4\uB290 \uB0A0 \uAC10\uC815 \uC758\uB8B0 \uB300\uC2E0 \uC790\uAE30
    \uC790\uC2E0\uC744 \uAC10\uC815\uD574\uBCF4\uACE0\uB294, \uC548\uC804\uD55C \uAE38\uB4DC
    \uC0DD\uD65C\uBCF4\uB2E4 \uC774 \uC2E0\uD765 \uB9C8\uC744\uC5D0\uC11C \uC7A5\uBE44\uC810\uC744
    \uC5EC\uB294 \uCABD\uC5D0 \uB354 \uB192\uC740 \uAC12\uC744 \uB9E4\uACBC\uB2E4.
    \uADF8\uB807\uAC8C \uC9C0\uAE08\uC740 \uC7A5\uBE44\uC810 \uC8FC\uC778\uC774\uC9C0\uB9CC,
    \uBF1B\uC18D\uAE4C\uC9C0\uB294 \uC5EC\uC804\uD788 \uAC10\uC815\uC0AC\uB2E4.\r\n\r\n\uC774\uC0C1\uD558\uAC8C\uB3C4
    \uADF8\uB140\uB294 \uADFC\uAC70 \uC5C6\uB294 \uD655\uC2E0\uC744 \uD558\uB098
    \uAC16\uACE0 \uC788\uB2E4 \u2014 \uC774 \uC7A5\uC0AC\uAC00 \uBC18\uB4DC\uC2DC
    \uD06C\uAC8C \uB420 \uAC70\uB77C\uB294 \uAC83. \uBCF8\uC778\uB3C4 \uC65C \uADF8\uB807\uAC8C
    \uBBFF\uB294\uC9C0 \uB17C\uB9AC\uC801\uC73C\uB85C \uC124\uBA85\uC740 \uBABB \uD55C\uB2E4.
    \uADF8\uB0E5 \"\uC7A5\uBE44\uB97C \uB2E4\uB8E8\uB294 \uC0AC\uB78C\uB4E4\uC740
    \uACB0\uAD6D \uB8EC \uC55E\uC5D0\uC11C \uC9C0\uAC11\uC744 \uC5F4\uAC8C \uB418\uC5B4
    \uC788\uB2E4\"\uB294 \uAC10\uC774 \uBAB8\uC5D0 \uC0C8\uACA8\uC838 \uC788\uC744
    \uBFD0. \uC190\uB2D8\uC774 \uAC15\uD654\uB098 \uB8EC \uD569\uC131\uC5D0 \uB3C8\uC744
    \uC4F8 \uB54C\uB9C8\uB2E4 \uD2B9\uBCC4\uD788 \uD2F0\uB294 \uC548 \uB0B4\uC9C0\uB9CC,
    \uC785\uAF2C\uB9AC\uAC00 \uC0B4\uC9DD \uC62C\uB77C\uAC00\uB294 \uAC78 \uBCF8
    \uC0AC\uB78C\uC740 \uBA87 \uC788\uB2E4.\r\n\r\n\uC131\uACA9\uC740 \uCC28\uBD84\uD558\uACE0
    \uC608\uC758 \uBC14\uB974\uC9C0\uB9CC \uBC29\uC2EC\uD560 \uC218 \uC5C6\uB294
    \uC7A5\uC0AC\uAFBC \uAE30\uC9C8\uC774 \uC788\uB2E4. \uAC12\uC744 \uAE4E\uC73C\uB824
    \uB4E4\uBA74 \uC6C3\uB294 \uC5BC\uAD74\uB85C \uC815\uD655\uD55C \uC6D0\uAC00\uC640
    \uC2DC\uC138 \uB370\uC774\uD130\uB97C \uB4E4\uC774\uBC00\uBA70 \uB418\uB808 \uC190\uB2D8\uC744
    \uC124\uB4DD\uD574\uBC84\uB9B0\uB2E4. \uC815\uC791 \uBCF8\uC778\uC740 \uB3C4\uBC15\uC744
    \uC2EB\uC5B4\uD574\uC11C, \uCF54\uB974\uD2B8\uC758 \uACBD\uB9E4\uC7A5\uC744 \"\uC22B\uC790\uC5D0
    \uD765\uBD84\uC744 \uC11E\uC5B4 \uD30C\uB294 \uACF3\"\uC774\uB77C\uBA70 \uBABB\uB9C8\uB545\uD574\uD55C\uB2E4.
    \uAC89\uC73C\uB85C\uB294 \uBB34\uB69D\uB69D\uD574 \uBCF4\uC5EC\uB3C4 \uB2E8\uACE8\uC5D0\uAC8C\uB294
    \uD544\uC694 \uC774\uC0C1\uC73C\uB85C \uC794\uC18C\uB9AC\uB97C \uD558\uB294 \uD3B8
    \u2014 \uC608\uB97C \uB4E4\uC5B4 \uBB34\uBAA8\uD558\uAC8C \uAC15\uD654\uB97C
    \uC2DC\uB3C4\uD558\uB824\uB294 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC644\uCDA9\uC81C\uBD80\uD130
    \uC0AC\uB77C\uACE0 \uC9C4\uC2EC\uC73C\uB85C \uB9D0\uB9B0\uB2E4. \uB208\uB9E4\uAC00
    \uB0A0\uCE74\uB86D\uACE0 \uD56D\uC0C1 \uB4F1\uC744 \uACE7\uAC8C \uD3B4\uACE0
    \uC788\uC5B4 \uB610\uB798\uBCF4\uB2E4 \uB098\uC774 \uB4E4\uC5B4 \uBCF4\uC778\uB2E4\uB294
    \uB9D0\uC744 \uC790\uC8FC \uB4E3\uB294\uB2E4. \uC190\uBAA9\uC5D0\uB294 \uAC10\uC815\uC0AC
    \uC2DC\uC808 \uC4F0\uB358 \uB0A1\uC740 \uD655\uB300\uACBD\uC744 \uC561\uC138\uC11C\uB9AC\uCC98\uB7FC
    \uAC78\uACE0 \uC788\uB2E4.\r\n\r\n**\uD638\uAC10\uB3C4 \uD61C\uD0DD:** \uD638\uAC10\uB3C4\uAC00
    \uB192\uC73C\uBA74 \uBCA0\uC774\uC2A4 \uC7A5\uBE44\uC640 \uB8EC\uC744 \uC2DC\uC138\uBCF4\uB2E4
    \uC800\uB834\uD558\uAC8C \uAD6C\uB9E4\uD560 \uC218 \uC788\uACE0, \uAC15\uD654
    \uC644\uCDA9\uC81C \uAC00\uACA9\uB3C4 \uD560\uC778\uB41C\uB2E4.\r\n\r\n**\uCD5C\uB300
    \uD638\uAC10\uB3C4 \uBCF4\uC0C1:** \uB8EC \uD569\uC131(\uB9AC\uB864) \uC2DC \uC694\uAD6C\uB418\uB294
    \uB8EC \uAC1C\uC218\uAC00 \uC601\uAD6C\uC801\uC73C\uB85C 1\uAC1C \uAC10\uC18C\uD55C\uB2E4.
    (\uC608: \uAE30\uC874 3\uAC1C \uD544\uC694 \u2192 2\uAC1C\uB85C \uACE0\uC815
    \uC801\uC6A9)"
