  m_Name: 50003
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_NPCData
  npcName: "\uC0C1\uC810 \uC18C\uB140"
  npcFriendlyName: "\uC0C1\uC810 \uC18C\uB140, \uC0D0\uB9AC"
  dialogues:
  - {fileID: 11400000, guid: 4a46d55c9f7d3294aa23932bee492701, type: 2}
  - {fileID: 11400000, guid: 503f60971662558448e75316e8d21f62, type: 2}
  - {fileID: 11400000, guid: f38c7132c8d7e694f890cba2e7d0135a, type: 2}
  - {fileID: 11400000, guid: bff1d477bd831c04fa6390978f852bea, type: 2}
  - {fileID: 11400000, guid: 480c86d426ed40f4291208afcc89dc8e, type: 2}
  - {fileID: 11400000, guid: 664f71fa2a6e9e74a933caaee8657b67, type: 2}
  preferGift: 
  memo: "\uB2F9\uCC28\uACE0 \uD65C\uAE30\uCC2C \uC18C\uB140. \uD2B9\uBCC4\uD560 \uAC83
    \uC5C6\uB294 \uC911\uB144 \uBD80\uBD80\uAC00 \uC6B4\uC601\uD558\uB294 \uC7A1\uD654\uC810\uC774
    \uB098\uB984 \uBD80\uD765\uD558\uB294 \uAC83\uC740 \uC678\uB3D9\uC778 \uADF8\uB140\uC758
    \uC21C\uC218\uD55C \uBBF8\uC18C\uAC00 \uD070 \uC601\uD5A5\uC774 \uC788\uC744
    \uAC83\uC774\uB2E4. \uC5B4\uB838\uC744 \uB54C\uBD80\uD130 \uC18C\uD53C\uC544\uB97C
    \uCE5C\uC5B8\uB2C8\uCC98\uB7FC \uB530\uB974\uBA70 \uC878\uC878 \uB530\uB77C\uB2E4\uB2C8\uBA70
    \uC790\uAE30 \uBAB8\uC744 \uC9C0\uD0AC \uC815\uB3C4\uC758 \uC2E4\uB825\uC740
    \uC9C0\uB154\uB2E4. \uACC4\uC0B0\uC774 \uCCA0\uC800\uD558\uB2E4. \uC758\uC678\uB85C
    \uB9C9\uAC00\uD30C\uC774\uBA70 \uC989\uD765\uC801\uC778 \uC131\uD5A5\uC774\uB2E4.
    \uB358\uC804\uC5D0\uB294 \uD070 \uAD00\uC2EC\uC5C6\uACE0 \uC7A1\uD654\uC810\uC744
    \uC774\uC5B4\uBC1B\uC544 \uB354\uC6B1 \uD06C\uAC8C \uC131\uC7A5\uC2DC\uCF1C \uBD80\uC790\uAC00
    \uB420 \uC0DD\uAC01\uC774 \uC788\uB2E4. \uCC45\uC784\uAC10\uC774 \uAC15\uD558\uB2E4.
    \uD559\uAD50\uB97C \uC548\uAC04\uB2E4\uACE0 \uD55C\uB2E4. \uCC9C\uC7AC\uC5EC\uC11C
    \uC774\uBBF8 \uBAA8\uB4E0 \uAD50\uC721\uC744 \uB9C8\uCCE4\uACE0 \uC7AC\uBBF8\uAC00
    \uC5C6\uC5B4\uC11C \uC548\uAC04\uB2E4\uACE0 \uD55C\uB2E4.\r\n\uD638\uAC10\uB3C4\uAC00
    \uB192\uB2E4\uBA74 \uBB3C\uD488\uB4E4\uC744 \uC800\uB834\uD558\uAC8C \uC5BB\uC744
    \uC218 \uC788\uACE0, \uAC04\uD639 \uC11C\uBE44\uC2A4(\uC5B4\uB514\uC11C \uAD6C\uD574\uC624\uB294\uC9C0
    \uBAA8\uB97C\uC815\uB3C4\uB85C \uC88B\uC740 \uBB3C\uAC74\uB4E4\uB3C4)\uB97C \uBC1B\uC744
    \uC218 \uC788\uB2E4. \uC774\uC678\uC5D0 \uC120\uC220\uC9D1\uC5D0\uC11C \uD55C
    \uD131 \uB0BC \uB54C (\uAC00\uB054\uC2DD \uC544\uBC84\uC9C0\uB97C \uCC3E\uC73C\uB7EC
    \uC624\uBA74\uC11C)\uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC120\uBB3C(\uC88B\uC740
    \uAC83\uB4E4)\uC744 \uD558\uAE30\uB3C4 \uD55C\uB2E4.\r\n\uCD5C\uB300 \uD638\uAC10\uB3C4\uC778
    \uACBD\uC6B0 \"\uC77C\uACF1 \uBE5B\uAE54\uC758 \uACE1\uB3C4\" \uC81C\uC791\uBC95\uC744
    \uC5BB\uC744 \uC218 \uC788\uB2E4. \uCC3D\uACE0\uC5D0 \uCCD0\uBC15\uD600\uC788\uB358\uAC78
    \uAC00\uC838\uC654\uB2E4\uACE0 \uD55C\uB2E4. \uC5B4\uC9DC\uD53C \uC7AC\uB8CC\uB97C
    \uAD6C\uD558\uAE30\uB3C4 \uC5B4\uB835\uACE0 \uB9CC\uB4E4\uAE30\uB3C4 \uC5B4\uB824\uC6B0\uB2C8
    \uC560\uBB3C\uB2E8\uC9C0\uB77C\uB294 \uB4EF. \uC81C\uC791\uBC95\uC740 \uC790\uAE30\uAC00
    \uC774\uBBF8 \uBA38\uB9BF\uC73C\uB85C \uC678\uC6CC\uC11C \uD544\uC694\uC5C6\uB2E4\uACE0
    \uD55C\uB2E4."
