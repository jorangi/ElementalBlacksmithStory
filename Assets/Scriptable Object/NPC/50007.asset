  m_Name: 50007
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_NPCData
  npcName: "\uBE44\uC2E4\uD55C \uACBD\uB9E4\uC0AC"
  npcFriendlyName: "\uBE44\uC2E4\uD55C \uACBD\uB9E4\uC0AC, \uCF54\uB974\uD06C"
  dialogues:
  - {fileID: 11400000, guid: 53771d2e75a9e93438160a5aeb89121c, type: 2}
  - {fileID: 11400000, guid: 9041b23eef3098542a26d831cdda2539, type: 2}
  - {fileID: 11400000, guid: 9009c6076ac0c0d4b8cfc19c828bf3f5, type: 2}
  - {fileID: 11400000, guid: 0b747485ab6d70c48b96b70f53428776, type: 2}
  - {fileID: 11400000, guid: 0df15fbf61fd8a84190de0baaf84a2e8, type: 2}
  - {fileID: 11400000, guid: 5189d4ff045e6b44997bc23022d2f3f3, type: 2}
  preferGift: 
  memo: "\uC0DD\uAE34 \uAC74 \uAD49\uC7A5\uD788 \uBE44\uC2E4\uD558\uAC8C \uC0DD\uACBC\uB2E4.
    \uD558\uC9C0\uB9CC \uBAA9\uC18C\uB9AC\uAC00 \uADF8 \uB204\uAD6C\uBCF4\uB2E4\uB3C4
    \uD06C\uB2E4. \uACC4\uC0B0\uC774 \uBE68\uB9AC\uBE68\uB9AC \uB3CC\uC544\uAC00\uACE0
    \uC790\uAE30 \uC7AC\uC0B0\uC774 \uC544\uB2CC\uB370\uB3C4 \uADF8\uB0E5 \uAC00\uACA9
    \uC624\uB974\uB294 \uAC78 \uBCF4\uB294 \uAC8C \uC88B\uB2E4\uACE0 \uD55C\uB2E4.
    \uB3C4\uD30C\uBBFC \uC911\uB3C5\uC790\uB77C\uC11C \uB9CE\uC740 \uC0AC\uB78C\uC758
    \uB3C8\uC774 \uC624\uAC00\uB294 \uD604\uC7A5\uC5D0\uC11C \uC6B4\uC744 \uB744\uC6B0\uB294
    \uD589\uC704 \uC790\uCCB4\uAC00 \uC990\uAC81\uB2E4\uACE0 \uD55C\uB2E4. \uADF8\uB798\uC11C
    \uC9C1\uC5C5 \uB9CC\uC871\uB3C4\uAC00 \uB9E4\uC6B0 \uB192\uC740 \uB4EF \uD558\uB2E4.
    \uAE50\uAE50\uD558\uAE34 \uD558\uC9C0\uB9CC \uB9D0\uC774 \uC548\uD1B5\uD558\uB294
    \uAC74 \uC544\uB2C8\uB2E4.\r\n\uD638\uAC10\uB3C4\uAC00 \uB192\uB2E4\uBA74 \uD50C\uB808\uC774\uC5B4\uAC00
    \uBB3C\uAC74 \uD310\uB9E4\uC2DC \uC218\uC218\uB8CC\uAC00 \uC808\uAC10\uB41C\uB2E4.\r\n\uD638\uAC10\uB3C4\uAC00
    \uCD5C\uB300\uC77C \uACBD\uC6B0 \"\uC800\uC8FC\uBC1B\uC740 \uACE0\uB300\uC758
    \uB9C8\uB3C4\uC11C\"\uC640 \uADF8 \uC81C\uC791\uBC95\uC744 \uC5BB\uC744 \uC218
    \uC788\uB2E4. \uC800\uC8FC\uBC1B\uC740 \uB9C8\uB3C4\uC11C\uB294 \uB9DE\uB294\uB370
    \uB108\uBB34 \uC61B\uB0A0 \uBB3C\uAC74\uC774\uB77C \uC800\uC8FC \uD6A8\uB825\uC774
    \uC774\uC81C \uC5C6\uB2E4\uACE0 \uD55C\uB2E4. \uADFC\uB370 \uC774\uB984\uB54C\uBB38\uC5D0
    \uC0AC\uB78C\uB4E4\uC774 \uC27D\uAC8C \uC190\uC744 \uC548\uB300\uC11C \uC548\uD314\uB9AC\uB294
    \uBB3C\uAC74.\r\n\uC2E4\uC81C\uB85C \uBB34\uAE30\uC810\uC5D0 \uD314\uACBD\uC6B0
    \uAE30\uBD84 \uCC1D\uCC1D\uD574\uC11C \uC548\uC0B0\uB2E4\uACE0 \uD558\uACE0,
    \uACBD\uB9E4\uC7A5\uC5D0\uC11C\uB3C4 \uD070 \uAC00\uACA9\uC740 \uBABB\uCCD0\uC900\uB2E4\uACE0
    \uBBF8\uB9AC \uB9D0\uD55C\uB2E4.(\uC2E4\uC81C\uB85C\uB3C4 \uAC00\uACA9\uC774
    \uB0AE\uACE0 \uB9C8\uC9C4\uB3C4 \uB0AE\uC74C)"
