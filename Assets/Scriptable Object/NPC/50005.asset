  npcName: "\uC120\uC220\uC9D1 \uC5EC\uC8FC\uC778"
  npcFriendlyName: "\uC120\uC220\uC9D1 \uC8FC\uC778, \uBA5C\uB9AC\uC544"
  dialogues:
  - {fileID: 11400000, guid: a6e27bf93d402ad47b706e0922f11ab3, type: 2}
  - {fileID: 11400000, guid: a30a9b87ccfd9bf4dbe879a5319a63a3, type: 2}
  - {fileID: 11400000, guid: 7a437eee6afd1ec4e85e2179a370839c, type: 2}
  - {fileID: 11400000, guid: 2f36dbc8834830541ba219e148661202, type: 2}
  - {fileID: 11400000, guid: ed33b39695b920b4c9532194d0873fd4, type: 2}
  - {fileID: 11400000, guid: b2d8825ac7f9b0241b6a771e38f9827a, type: 2}
  preferGift: 
  memo: "\uC120\uC220\uC9D1 \uC138\uC158\uC5D0\uC11C \uBCFC \uC218 \uC788\uB294 NPC\uB85C
    \uBCF4\uB9AC\uC2A4\uC758 \uC544\uB0B4\uC774\uB2E4. \uAC00\uB054 \uBCF4\uB9AC\uC2A4
    \uB300\uC2E0 \uB4F1\uC7A5\uD55C\uB2E4. \uB9D0\uC774 \uB9CE\uACE0 \uC131\uACA9\uC774
    \uAC70\uC138\uB2E4. \uAD49\uC7A5\uD55C \uBBF8\uC778. \uC120\uC220\uC9D1 \uC790\uCCB4\uB294
    \uADF8\uB140\uC758 \uAC83\uC774\uB098 \uC6B4\uC601\uC740 \uB0A8\uD3B8\uC5D0\uAC8C
    \uB9E1\uACBC\uB2E4. \uB300\uBD80\uBD84\uC758 \uC2DC\uAC04\uC744 \uC9D1\uC5D0\uC11C
    \uC544\uC774\uB97C \uB3CC\uBCF4\uB294\uB370 \uC0AC\uC6A9\uD558\uB294\uB370, \uAC04\uD639
    \uB0A8\uD3B8\uC774 \uAE09\uD55C \uC77C\uC774 \uC788\uAC70\uB098 \uD734\uC2DD\uC744
    \uD560 \uB54C \uB300\uC2E0 \uB098\uC624\uB294 \uB4EF \uD558\uB2E4. \uC694\uC998
    \uAD00\uC2EC\uC0AC\uB294 \uC6B4\uB3D9\uC778\uB4EF \uD558\uB2E4. \uC758\uC678\uB85C
    \uBCF4\uB9AC\uC2A4\uBCF4\uB2E4 \uC5F0\uC0C1\uC774\uBA70 \uC6D0\uB798\uB294 \uADC0\uC871\uC774\uC5C8\uB294\uB370
    \uC0DD\uD65C\uC5D0 \uC5FC\uC99D\uC744 \uB290\uAEF4 \uB3C4\uB9DD\uB098\uC654\uB2E4\uB294\uB4EF.\r\n\uBCF4\uB9AC\uC2A4\uC640
    \uACF5\uC720\uD558\uB294 \uC120\uC220\uC9D1 \uC8FC\uC778\uC73C\uB85C\uC11C\uC758
    \uD638\uAC10\uB3C4\uAC00 \uC788\uC73C\uBA70 \uBCF4\uB9AC\uC2A4 \uAC1C\uC778\uC73C\uB85C\uC11C\uC758
    \uD638\uAC10\uB3C4\uAC00 \uB098\uB258\uC5B4\uC788\uB2E4.\r\n\uC120\uC220\uC9D1
    \uC8FC\uC778\uC73C\uB85C\uC11C\uC758 \uD638\uAC10\uB3C4\uAC00 \uB192\uB2E4\uBA74
    \uD55C \uD131 \uB0BC \uB54C, \uAC04\uD639 \uC18C\uBB38 \uC220\uC794\uC774 \uAC10\uC18C\uD558\uC9C0
    \uC54A\uB294\uB2E4. \uB610\uD55C \uBC1C\uC8FC\uC640 \uC218\uC8FC \uAC00\uB2A5\uD55C
    \uD018\uC2A4\uD2B8\uC758 \uC218\uAC00 \uB298\uC5B4\uB09C\uB2E4.\r\n\uBA5C\uB9AC\uC544\uB85C\uC11C\uC758
    \uD638\uAC10\uB3C4\uAC00 \uB192\uB2E4\uBA74 \uC6A9\uBCD1 \uC2AC\uB86F\uC774 1\uC99D\uAC00\uD558\uBA70
    \uC6A9\uBCD1\uB4E4\uC758 \uACF5\uACA9\uC18D\uB3C4\uAC00 \uC99D\uAC00\uD55C\uB2E4.
    \uAC00\uB054 \uBCF8\uAC00\uC5D0\uC11C \uBCF4\uB0B4\uC624\uB294 \uC120\uBB3C(\uC7A5\uC2E0\uAD6C
    \uB4F1)\uC744 \uB5A0\uB118\uAE30\uAE30\uB3C4 \uD55C\uB2E4."
