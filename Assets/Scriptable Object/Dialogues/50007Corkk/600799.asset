  m_Script: {fileID: 11500000, guid: b95dc85e94140ab4a84be25b52aada74, type: 3}
  m_Name: 600799
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_DialogueData
  description: "\uBE44\uC2E4\uD55C \uAD50\uC5ED\uC18C \uAD00\uB9AC\uC778, \uCF54\uB974\uD06C\n\uD638\uAC10\uB3C4
    \uCD5C\uB300 \uC774\uBCA4\uD2B8 (\uC800\uC8FC\uBC1B\uC740 \uACE0\uB300\uC758
    \uB9C8\uB3C4\uC11C)"
  contents:
  - speakerId: 50007
    text: "...\uC774 \uCC45 \uB9D0\uC500\uC774\uC2ED\uB2C8\uAE4C. '\uC800\uC8FC\uBC1B\uC740
      \uACE0\uB300\uC758 \uB9C8\uB3C4\uC11C'. \uC774\uB984\uB9CC \uADF8\uB807\uACE0,
      \uC800\uC8FC\uB294 \uC624\uB798\uC804\uC5D0 \uB2E4 \uC2DD\uC5C8\uC2B5\uB2C8\uB2E4."
  - speakerId: 50007
    text: "\uADF8\uB798\uB3C4 \uC544\uBB34\uB3C4 \uC190\uB300\uC9C0 \uC54A\uB354\uAD70\uC694.
      \uACBD\uB9E4\uC5D0 \uC62C\uB9AC\uBA74 \uAC00\uACA9\uC774 \uC548 \uC624\uB974\uACE0,
      \uBB34\uAE30\uC810\uC740 \uCC1D\uCC1D\uD558\uB2E4\uACE0 \uB3CC\uB824\uBCF4\uB0B4\uACE0\uC694."
  - speakerId: 50007
    text: "\uAC00\uACA9\uC774 \uC548 \uC624\uB974\uB294 \uBB3C\uAC74\uC740 \uBCF4\uACE0
      \uC788\uC73C\uBA74 \uC880 \uC4F8\uC4F8\uD569\uB2C8\uB2E4. {username} \uB2D8\uC774
      \uAC00\uC838\uAC00 \uC8FC\uC2DC\uBA74, \uC774 \uCC45\uC5D0\uB3C4 \uB4DC\uB514\uC5B4
      \uC22B\uC790\uAC00 \uBD99\uACA0\uAD70\uC694."
  - speakerId: 50007
    text: "\uC81C\uC791\uBC95\uB3C4 \uAC19\uC774 \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.
      \uAC12\uC740 \uBC1B\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4. \uC624\uB298\uB9CC\uC694.
      ...\uAC00\uB054\uC740 \uC774 \uCC45\uC774 \uC5B4\uB5BB\uAC8C \uC9C0\uB0B4\uB294\uC9C0
      \uC54C\uB824 \uC8FC\uC138\uC694."
