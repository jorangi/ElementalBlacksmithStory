  m_Name: 600808
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_DialogueData
  description: "\uC0C1\uC810 \uC785\uC7A5/\uAD6C\uB9E4 \uCE74\uD2B8\uC5D0 \uBB3C\uAC74\uC744
    \uB2F4\uC74C "
  contents:
  - speakerId: 50008
    text: "{itemCount == 0 ? \uB9E4\uC785\uD558\uC2E4 \uBB3C\uAC74\uC774 \uC788\uC73C\uC138\uC694?
      \uC0C1\uD0DC\uBD80\uD130 \uAF3C\uAF3C\uD788 \uC0B4\uD3B4\uBCFC\uAC8C\uC694.
      : {itemCount == 1 ? '{item1}' {totalAmount}\uAC1C, \uAC10\uC815\uD574\uBCF4\uB2C8
      <b>{totalCost}</b>(\uC774\uB124/\uB124)\uC694. \uC774 \uC774\uC0C1\uC740 \uBB34\uB9AC\uC608\uC694.
      : '{item1}', '{item2}' \uB4F1 {totalAmount}\uAC1C, \uC804\uBD80 \uAC10\uC815\uD55C
      \uACB0\uACFC <b>{totalCost}</b>(\uC774\uB124/\uB124)\uC694. \uADFC\uAC70 \uC788\uB294
      \uAC00\uACA9\uC774\uB2C8 \uBBFF\uC73C\uC154\uB3C4 \uB3FC\uC694.}}"
