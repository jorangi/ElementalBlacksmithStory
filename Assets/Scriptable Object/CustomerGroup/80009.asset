%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b32617f483474c042a505f5b4002c486, type: 3}
  m_Name: 80009
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_CustomerGroup
  _customerGroupTitle: 떠돌이 사냥꾼
  _customerGroupName: 숲의 그림자
  _description: 숲과 산맥을 누비는 고독한 사냥꾼들. 활과 가벼운 장비, 야생 동물 가죽 및 소재에 관심이 많다.
  minEstimateRatio: 0.85
  maxEstimateRatio: 1.25
  minFirstOfferRatio: 0.6
  maxFirstOfferRatio: 0.75
  minInterpolation: 0.15
  maxInterpolation: 0.3
  minPatience: 70
  maxPatience: 100
  greedSensitivity: 1.2
  _customerNames:
  - 라이언
  - 헤이즐
  - 코너
  - 실바
  - 아샤
  - 오크
  - 바람
  - 브라이어
  - 토르벤
  - 메이플
  _customerSprites: []
  _firstOffer:
  - speakerId: 0
    text: '{itemType == material ? "결이 곱군. 겨울 나기 전에 쟁여 둘 만해." : {itemType == consumable ? "쓰고 나면 없어지는 것들이라 늘 모자라지. 마침 떨어졌어." : "눈에 들어오는 물건이군."}} {price}골드.'
  - speakerId: 0
    text: '{itemName}... 손으로 한번 만져 보고 싶군. {price}골드.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개. 다 가져가지. 합쳐서 {price}골드." : "하나면 돼. {price}골드."}'
  - speakerId: 0
    text: '냄새가 좋아. 오래 묵은 물건은 아니군. {price}골드 주지.'
  - speakerId: 0
    text: '{price}골드. 깎을 생각은 없어. 말 많은 건 질색이라.'
  - speakerId: 0
    text: '{price >= baseValue ? "제값은 쳐주지. {price}골드." : "급한 건 아니니 {price}골드부터 말하지."}'
  - speakerId: 0
    text: '{itemType == material ? "쓸 만한 재료는 산에서도 구하기 어렵지. {price}골드." : {itemType == consumable ? "산에서는 하나가 목숨 값이야. 아끼지 않고 쳐주지. {price}골드." : "쓸 만하군. {price}골드."}}'
  - speakerId: 0
    text: '{groupName}의 {npcName}. {itemName}(을/를) {price}골드에 사지.'
  - speakerId: 0
    text: '눈이 오기 전에 채워 둬야 해서. {price}골드, 어때.'
  - speakerId: 0
    text: '상한 데가 없군. 보관을 잘했어. {price}골드.'
  _negotiation:
  - speakerId: 0
    text: '{prevPrice}골드에서 {price}골드. 이게 내 답이야.'
  - speakerId: 0
    text: '{askPrice}골드는 과해. {price}골드까지.'
  - speakerId: 0
    text: '{bargainCount >= 2 ? "같은 말을 몇 번 하는 거지. {price}골드. 더는 안 변해." : "좋아. {price}골드까지 올리지."}'
  - speakerId: 0
    text: '{askRatio >= 1.5 ? "{askPrice}골드라니. 그런 값을 부르는 놈은 짐승보다 먼저 당해. {price}골드." : "{askPrice}골드는 조금 높군. {price}골드로 맞추지."}'
  - speakerId: 0
    text: '{priceGap}골드 차이군. 그만큼은 못 메워. {price}골드.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개면 개당 {unitPrice}골드꼴이군. 합쳐서 {price}골드." : "하나치고는 후하게 쳤어. {price}골드."}'
  - speakerId: 0
    text: '{itemType == material ? "재료는 철 따라 값이 달라져. 지금 철엔 {price}골드가 맞아." : {itemType == consumable ? "소모품은 쓰는 사람이 값을 알아. 내가 아는 값은 {price}골드." : "내가 아는 값은 {price}골드."}}'
  - speakerId: 0
    text: '말을 아끼지. {price}골드.'
  - speakerId: 0
    text: '{price >= baseValue ? "제값 이상이야. 더는 못 줘. {price}골드." : "{price}골드. 이 정도면 공평하지."}'
  - speakerId: 0
    text: '{npcName}(은/는) 한 번 정한 값은 잘 안 바꿔. 이번만 {price}골드로 올리지.'
  _finalOffer:
  - speakerId: 0
    text: '마지막이야. {price}골드. 싫으면 말해.'
  - speakerId: 0
    text: '{firstPrice}골드로 시작해서 {price}골드까지 왔어. 여기까지야.'
  - speakerId: 0
    text: '해 지기 전에 움직여야 해. {price}골드, 정해.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개에 {price}골드. 더는 없어." : "하나에 {price}골드. 더는 없어."}'
  - speakerId: 0
    text: '{askPrice}골드는 안 돼. {price}골드면 사지.'
  - speakerId: 0
    text: '{itemName}(이/가) 좋긴 해도 {price}골드 위로는 못 가.'
  - speakerId: 0
    text: '{askRatio >= 1.5 ? "{priceGap}골드나 벌어졌군. 더 얘기해 봐야 같은 답이야. {price}골드." : "{price}골드. 이 정도 차이는 눈 감지."}'
  - speakerId: 0
    text: '{itemType == material ? "재료에 더 쓸 돈은 남겨 두지 않았어. {price}골드." : {itemType == consumable ? "소모품은 아껴 쓰면 돼. 더 얹을 이유는 없어. {price}골드." : "더 얹을 이유는 없어. {price}골드."}}'
  - speakerId: 0
    text: '{npcName}의 마지막 말이야. {price}골드.'
  - speakerId: 0
    text: '답이 느리군. 기다리는 데는 익숙하지만 길게는 안 해. {price}골드.'
  _acception:
  - speakerId: 0
    text: '좋아. 그 값으로 하지.'
  - speakerId: 0
    text: '{itemType == material ? "결이 좋은 걸 구했군. 겨울 준비가 한결 낫겠어." : {itemType == consumable ? "이만큼이면 한 철은 버티겠어." : "좋은 물건이군. 잘 쓰지."}}'
  - speakerId: 0
    text: '{price}골드. 확인해.'
  - speakerId: 0
    text: '{itemName}(을/를) 챙기지. 신세 졌군.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개 다 가져가지. 수고했어." : "가져가지. 수고했어."}'
  - speakerId: 0
    text: '말이 짧아서 편했어.'
  - speakerId: 0
    text: '{groupName}(은/는) 값을 치른 만큼 기억해.'
  - speakerId: 0
    text: '{npcName}(이/가) 신세를 졌군. 기억해 두지.'
  - speakerId: 0
    text: '{price >= baseValue ? "제값 이상으로 쳤으니 마음 편히 가져가지." : "제값이면 충분해. 가져가지."}'
  - speakerId: 0
    text: '바람이 바뀌기 전에 가야겠군. 거래 고마워.'
  _rejection:
  - speakerId: 0
    text: '맞지 않군. 이만 가지.'
  - speakerId: 0
    text: '{askPrice}골드는 안 사.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개든 하나든 그 값은 아니야. 간다." : "그 값은 아니야. 간다."}'
  - speakerId: 0
    text: '{itemName}(이/가) 좋긴 하지만 그 값엔 못 사. 발길을 돌리지.'
  - speakerId: 0
    text: '{itemType == material ? "재료는 다른 데서도 구할 수 있어. 이만 가지." : {itemType == consumable ? "소모품은 아껴 쓰면 돼. 이번엔 접지." : "다른 길로 구해 보지."}}'
  - speakerId: 0
    text: '더 말해 봐야 같아. 접지.'
  - speakerId: 0
    text: '{npcName}(은/는) 값이 안 맞으면 미련 두지 않아.'
  - speakerId: 0
    text: '{groupName}(은/는) 말 길게 끄는 거래는 안 해.'
  - speakerId: 0
    text: '{askRatio >= 1.5 ? "그 값을 부를 줄은 몰랐군. 접지." : "조금만 더 맞았으면. 다음에 보지."}'
  - speakerId: 0
    text: '해가 기울고 있어. 길을 가야 해.'
