  _customerGroupTitle: "\uB5A0\uB3CC\uC774 \uC0AC\uB0E5\uAFBC"
  _customerGroupName: "\uC232\uC758 \uADF8\uB9BC\uC790"
  _description: "\uC232\uACFC \uC0B0\uB9E5\uC744 \uB204\uBE44\uB294 \uACE0\uB3C5\uD55C
    \uC0AC\uB0E5\uAFBC\uB4E4. \uD65C\uACFC \uAC00\uBCBC\uC6B4 \uC7A5\uBE44, \uC57C\uC0DD
    \uB3D9\uBB3C \uAC00\uC8FD \uBC0F \uC18C\uC7AC\uC5D0 \uAD00\uC2EC\uC774 \uB9CE\uB2E4."
