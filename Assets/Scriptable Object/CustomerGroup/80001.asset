%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b32617f483474c042a505f5b4002c486, type: 3}
  m_Name: 80001
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_CustomerGroup
  _customerGroupTitle: 초보 모험가
  _customerGroupName: 풋내기 개척단
  _description: 갓 길드에 등록한 풋내기 모험가들. 주머니는 가볍지만 모험에 대한 열정은 뜨겁다. 실용적이고 저렴한 입문용 무기를 찾는다.
  minEstimateRatio: 0.75
  maxEstimateRatio: 1.05
  minFirstOfferRatio: 0.5
  maxFirstOfferRatio: 0.7
  minInterpolation: 0.2
  maxInterpolation: 0.35
  minPatience: 50
  maxPatience: 80
  greedSensitivity: 1.4
  _customerNames:
  - 루키
  - 토미
  - 피핀
  - 로빈
  - 티모
  - 레오
  - 노아
  - 미아
  - 핀
  - 쿠키
  _customerSprites: []
  _firstOffer:
  - speakerId: 0
    text: '{itemType == sword ? "우와, 검이다! 멋있다..." : {itemType == bow ? "우와, 활이다! 제가 쓰기 딱 좋아 보여요!" : {itemType == rune ? "룬이라니, 실물은 처음 봐요!" : {itemType == material ? "와, 재료가 이렇게 반짝거려요?!" : "와, 이거 정말 좋아 보여요!"}}}} {price}골드면... 살 수 있을까요?'
  - speakerId: 0
    text: '저, 저기... 이제 막 시작해서 많이는 못 드려요. {price}골드면 될까요?'
  - speakerId: 0
    text: '선배들이 이런 건 꼭 직접 보고 사라고 했어요! {price}골드로 부탁드려요!'
  - speakerId: 0
    text: '가진 돈을 탈탈 털어 왔어요... {price}골드가 최대예요!'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개나 필요한데... 한꺼번에 {price}골드면 안 될까요?" : "하나면 충분해요! {price}골드는 어떨까요?"}'
  - speakerId: 0
    text: '이 금액이면 다음 의뢰 때까지 겨우 버텨요... {price}골드, 가능할까요?'
  - speakerId: 0
    text: '{itemType == material ? "재료는 처음 사 보는데, 이 가격이 맞는 거예요?" : "처음 사 보는 거라 시세를 잘 몰라요..."} {price}골드 정도로 생각했어요!'
  - speakerId: 0
    text: '제 형편에 이게 한계예요... {price}골드, 어떠세요?'
  - speakerId: 0
    text: '혹시 {price}골드에 팔아 주실 수 있나요? 열심히 모아 왔어요!'
  - speakerId: 0
    text: '이거 꼭 갖고 싶어요! {price}골드 드릴게요, 제발요!'
  _negotiation:
  - speakerId: 0
    text: '조, 조금만 더 깎아 주시면 안 될까요? 다음 의뢰 끝나면 꼭 또 올게요!'
  - speakerId: 0
    text: '{price}골드로 안 될까요? 정말 빠듯해요...'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개나 사는 거니까 조금만 봐주세요!" : "딱 하나뿐이니까 조금만 봐주세요!"} {price}골드면 정말 감사하겠어요!'
  - speakerId: 0
    text: '빵값까지 쪼개서 모은 돈이에요, 흑... {price}골드, 어떠세요?'
  - speakerId: 0
    text: '너무 깎는 것 같죠... 죄송해요! 그래도 {price}골드만 받아 주세요!'
  - speakerId: 0
    text: '{itemType == sword ? "검이 비싸다는 말은 들었는데... 이렇게나요?!" : {itemType == bow ? "활이 비싸다는 말은 들었는데... 이렇게나요?!" : {itemType == rune ? "룬이 비싸다는 말은 들었는데... 이렇게나요?!" : {itemType == material ? "재료가 이렇게 비쌀 줄은 몰랐어요!" : "이렇게 비쌀 줄은 몰랐어요!"}}}} {price}골드까지는 어떻게든 맞춰 볼게요!'
  - speakerId: 0
    text: '제발요, 이번이 첫 장비란 말이에요! {price}골드로 부탁드려요!'
  - speakerId: 0
    text: '으으... 조금만 더 올려 볼게요! {price}골드는 어떨까요?'
  - speakerId: 0
    text: '선배한테 돈을 빌려서라도 {price}골드는 맞출게요!'
  - speakerId: 0
    text: '나중에 더 많이 사 드릴게요, 약속해요! 지금은 {price}골드만요!'
  _finalOffer:
  - speakerId: 0
    text: '진짜 이게 마지막이에요... {price}골드, 더는 한 푼도 없어요!'
  - speakerId: 0
    text: '주머니를 다 털었어요... {price}골드로 부탁드려요, 제발!'
  - speakerId: 0
    text: '{price}골드가 제 전 재산이에요, 흑... 이걸로 안 되면 포기할게요!'
  - speakerId: 0
    text: '정말로 끝이에요! {price}골드, 받아 주시면 안 될까요?'
  - speakerId: 0
    text: '이 이상은 오늘 밥도 못 먹어요... {price}골드가 최대예요!'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개를 다 사려면 이게 한계예요!" : "하나만 사는데도 이게 한계예요!"} {price}골드, 부탁드려요...'
  - speakerId: 0
    text: '빌려 온 돈까지 다 넣었어요! {price}골드예요, 진짜로요!'
  - speakerId: 0
    text: '더 말하면 울 것 같아요... {price}골드, 이게 끝이에요!'
  - speakerId: 0
    text: '{price}골드, 이걸로 정말 마지막이에요! 결정해 주세요!'
  - speakerId: 0
    text: '제발 {price}골드에 해 주세요... 더는 방법이 없어요!'
  _acception:
  - speakerId: 0
    text: '{itemType == sword ? "검이 내 손에!" : {itemType == bow ? "활이 내 손에!" : {itemType == rune ? "룬이 내 손에!" : {itemType == material ? "재료를 구했다!" : "드디어 구했다!"}}}} 정말 감사합니다!'
  - speakerId: 0
    text: '와, 정말요?! 고맙습니다, 소중하게 쓸게요!'
  - speakerId: 0
    text: '해냈다! 이걸로 다음 의뢰는 문제없어요!'
  - speakerId: 0
    text: '감사합니다! 선배들한테 자랑해야지!'
  - speakerId: 0
    text: '{itemType == sword ? "이 검으로 첫 사냥 나가요!" : {itemType == bow ? "이 활로 첫 사냥 나가요!" : "이걸로 첫 의뢰 나가요!"}} 고맙습니다!'
  - speakerId: 0
    text: '이렇게 깎아 주시다니... 이 은혜 잊지 않을게요!'
  - speakerId: 0
    text: '정말 감사합니다! 더 큰돈 벌어서 또 올게요!'
  - speakerId: 0
    text: '믿기지가 않아요... 진짜 제 거예요?! 잘 쓰겠습니다!'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개나 팔아 주시다니 감사해요!" : "하나뿐인데 팔아 주셔서 감사해요!"} 열심히 할게요!'
  - speakerId: 0
    text: '오늘은 제 인생 최고의 날이에요!'
  _rejection:
  - speakerId: 0
    text: '역시 저한테는 너무 비싸네요... 돈 모아서 다시 올게요!'
  - speakerId: 0
    text: '아쉽지만... 포기할게요. 다음에 또 와도 될까요?'
  - speakerId: 0
    text: '알겠어요, 흑... 더 열심히 벌어서 올게요!'
  - speakerId: 0
    text: '{itemType == sword ? "검은 아직 제게 이른가 봐요..." : {itemType == bow ? "활은 아직 제게 이른가 봐요..." : {itemType == rune ? "룬은 아직 제게 이른가 봐요..." : {itemType == material ? "재료는 아직 제게 이른가 봐요..." : "이건 아직 제게 이른가 봐요..."}}}} 다음엔 꼭 올게요!'
  - speakerId: 0
    text: '죄송해요, 제 형편으로는 무리예요... 다음에 올게요!'
  - speakerId: 0
    text: '아... 안 되는 거군요. 돈이 모이면 꼭 다시 올게요!'
  - speakerId: 0
    text: '흐엉... 어쩔 수 없죠. 안녕히 계세요!'
  - speakerId: 0
    text: '다른 곳도 둘러보고 올게요! 좋은 물건 보여 주셔서 감사했어요!'
  - speakerId: 0
    text: '제 실력에 맞는 걸 먼저 찾아봐야겠어요... 죄송합니다!'
  - speakerId: 0
    text: '오늘은 구경만 한 걸로 할게요! 다음엔 꼭 살 거예요!'
