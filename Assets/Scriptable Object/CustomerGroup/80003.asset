%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b32617f483474c042a505f5b4002c486, type: 3}
  m_Name: 80003
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBlacksmithStory.Data.SO_CustomerGroup
  _customerGroupTitle: 베테랑 용병
  _customerGroupName: 검은 늑대 용병대
  _description: 수많은 전장을 거치며 뼈가 굵은 거친 실전파들. 겉멋보단 내구성과 살상력을 우선시하며, 성미가 급해 질질 끄는 흥정을 싫어한다.
  minEstimateRatio: 0.9
  maxEstimateRatio: 1.35
  minFirstOfferRatio: 0.6
  maxFirstOfferRatio: 0.8
  minInterpolation: 0.25
  maxInterpolation: 0.4
  minPatience: 45
  maxPatience: 75
  greedSensitivity: 1.5
  _customerNames:
  - 가츠
  - 브란
  - 카림
  - 울프
  - 바르톡
  - 라그나
  - 도르간
  - 하칸
  - 질
  - 그롬
  _customerSprites: []
  _firstOffer:
  - speakerId: 0
    text: '{itemType == sword ? "날이 살아 있군. 전장에서 몇 번은 버티겠어." : {itemType == bow ? "시위 감이 좋아. 멀리서 끝내기엔 딱이군." : {itemType == rune ? "기운이 심상치 않군. 쓸 데는 많겠어." : {itemType == material ? "물건 질이 고르군. 쓸 만해." : "눈에 들어오는 물건이군."}}}} {price}골드면 되겠지. 길게 끌 생각 없어.'
  - speakerId: 0
    text: '{itemElement != none ? "속성이 깃들었군. 전장에서 먹히겠어." : "{itemName}, 내구성은 쓸 만해 보이는군."} {price}골드. 바로 답해.'
  - speakerId: 0
    text: '{price}골드 준다. 고민할 것 없잖아.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개 전부 가져가지. 개당 {unitPrice}골드, 합쳐서 {price}골드야." : "하나면 돼. {price}골드야."} 빨리 정하지.'
  - speakerId: 0
    text: '{groupName} 소속 {npcName}. {itemName}(을/를) {price}골드에 가져가지.'
  - speakerId: 0
    text: '겉치레는 필요 없어. 쓸모만 있으면 돼. {price}골드.'
  - speakerId: 0
    text: '{itemType == sword ? "벨 수 있으면 그걸로 충분해." : {itemType == bow ? "쏴서 맞으면 그걸로 충분해." : "쓸모만 있으면 그걸로 충분해."}} {price}골드, 어때.'
  - speakerId: 0
    text: '{itemName}에 {price}골드면 후한 편이지. 생각할 시간 없다.'
  - speakerId: 0
    text: '{itemType == material ? "재료는 쓰고 버리면 그만이야. {price}골드면 충분하지." : {itemType == rune ? "룬은 쓸 줄 아는 놈이 임자야. {price}골드 준다." : "쓸 놈이 임자야. {price}골드 준다."}}'
  - speakerId: 0
    text: '{npcTitle} 눈은 못 속여. {itemName}에 {price}골드면 적당하지.'
  _negotiation:
  - speakerId: 0
    text: '쯧, 좋아. {price}골드까지 올려주지. 이걸로 끝내자.'
  - speakerId: 0
    text: '{askPrice}골드? 배짱 좋군. {price}골드까지다.'
  - speakerId: 0
    text: '{bargainCount >= 2 ? "벌써 몇 번째야. {price}골드, 이게 마지막 양보다." : "{price}골드. 더 끌면 나는 간다."}'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개 값으로 {price}골드면 충분해." : "한 점에 {price}골드면 충분해."} 어쩔 건가.'
  - speakerId: 0
    text: '{itemName}(이/가) 쓸 만한 건 인정하지. {price}골드. 이게 거의 한계야.'
  - speakerId: 0
    text: '{prevPrice}골드에서 {price}골드로 올렸다. 한 번 더 말하게 하지 마.'
  - speakerId: 0
    text: '{askRatio >= 1.5 ? "{askPrice}골드는 말이 안 돼. 장난하나. {price}골드야." : "{askPrice}골드는 과해. {price}골드로 맞춰."}'
  - speakerId: 0
    text: '{priceGap}골드 차이쯤은 내가 접지. {price}골드야. 정해.'
  - speakerId: 0
    text: '난 같은 말 두 번 하는 거 싫어한다. {price}골드야.'
  - speakerId: 0
    text: '{itemElement != none ? "속성이 붙은 값은 쳐주지. {price}골드, 끝내지." : "흥정할 시간에 한 놈이라도 더 벤다. {price}골드, 끝내지."}'
  _finalOffer:
  - speakerId: 0
    text: '더는 못 올려. {price}골드, 받든가 말든가 둘 중 하나야.'
  - speakerId: 0
    text: '마지막이다. {price}골드. 싫으면 돌아선다.'
  - speakerId: 0
    text: '{firstPrice}골드로 시작해서 {price}골드까지 왔다. 이게 끝이야.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개에 {price}골드가 전부다." : "{price}골드가 전부다."} 정해.'
  - speakerId: 0
    text: '마지막으로 하는 경고다. {price}골드.'
  - speakerId: 0
    text: '{itemName}(이/가) 아무리 좋아도 {price}골드 이상은 없다.'
  - speakerId: 0
    text: '{askPrice}골드는 안 줘. {price}골드, 지금 답해.'
  - speakerId: 0
    text: '{askRatio >= 1.5 ? "{priceGap}골드나 벌어졌어. 메울 생각 없다. {price}골드가 끝이야." : "발걸음 돌리기 전에 답해. {price}골드."}'
  - speakerId: 0
    text: '{itemType == material ? "재료에 더 쓸 돈은 없어." : {itemType == rune ? "룬에 더 쓸 돈은 없어." : "물건에 더 쓸 돈은 없어."}} {price}골드다.'
  - speakerId: 0
    text: '주머니 사정은 뻔해. {price}골드가 끝이야.'
  _acception:
  - speakerId: 0
    text: '좋아. 거래 끝이다.'
  - speakerId: 0
    text: '{itemType == sword ? "이 검이면 다음 싸움은 걱정 없겠어." : {itemType == bow ? "이 활이면 다음 싸움은 걱정 없겠어." : "이 물건이면 다음 싸움은 걱정 없겠어."}}'
  - speakerId: 0
    text: '{price}골드. 여기 있다. 확인해.'
  - speakerId: 0
    text: '빠르군. 마음에 들어.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개 전부 챙겨 가지." : "챙겨 가지."} 수고했어.'
  - speakerId: 0
    text: '{itemName}(은/는) 내가 쓰지. 잘 팔았어.'
  - speakerId: 0
    text: '{npcTitle}(은/는) 값을 치르면 뒤끝이 없어. 가지.'
  - speakerId: 0
    text: '신세 하나 졌군. 기억해 두지.'
  - speakerId: 0
    text: '{itemElement != none ? "속성이 깃든 물건이라니, 운이 좋군. 잘 쓰지." : "좋아. 늑대는 값을 치르면 뒤끝이 없어."}'
  - speakerId: 0
    text: '군말 없어서 좋군. 가지.'
  _rejection:
  - speakerId: 0
    text: '말이 안 통하는군. 시간만 날렸어. 다른 데 알아보지.'
  - speakerId: 0
    text: '됐다. 갈 길이 바쁘다.'
  - speakerId: 0
    text: '{askPrice}골드엔 안 사. 다른 놈한테 가지.'
  - speakerId: 0
    text: '{itemCount > 1 ? "{itemCount}개 값치고는 터무니없군." : "그 값은 터무니없군."} 접는다.'
  - speakerId: 0
    text: '{itemName}(이/가) 좋은 건 알지만 그 값엔 못 사. 간다.'
  - speakerId: 0
    text: '{groupName}(은/는) 시간 낭비 안 해. 이만 가지.'
  - speakerId: 0
    text: '난 같은 말을 되풀이하지 않아. 간다.'
  - speakerId: 0
    text: '{itemType == sword ? "검은 다른 데서도 구해." : {itemType == bow ? "활은 다른 데서도 구해." : "물건은 다른 데서도 구해."}} 이만 가지.'
  - speakerId: 0
    text: '{askRatio >= 1.5 ? "그 값을 부르는 놈이랑은 말 섞기 싫군. 간다." : "답이 늦군. 기다리는 건 성미에 안 맞아."}'
  - speakerId: 0
    text: '결판 못 내는 상대랑은 안 해. 이만 가지.'
  _minTimer: 30
  _maxTimer: 60
