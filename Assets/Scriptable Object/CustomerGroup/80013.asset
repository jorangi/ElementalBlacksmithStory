  _customerSprites: []
  _firstOffer:
  - speakerId: 0
    text: "{itemElement == holy ? \"\uC774 \uBB3C\uAC74\uC5D0\uC11C \uB9D1\uC740
      \uBE5B\uC774 \uB290\uAEF4\uC9D1\uB2C8\uB2E4. \uC0C8\uBCBD \uCCAB \uD587\uC0B4
      \uAC19\uAD70\uC694.\" : {itemType == rune ? \"\uB8EC\uC774\uAD70\uC694. \uBAB8\uC5D0
      \uC9C0\uB2C8\uBA74 \uBD80\uC801 \uBABB\uC9C0\uC54A\uACA0\uC2B5\uB2C8\uB2E4.\"
      : {itemType == consumable ? \"\uAE38 \uC704\uC5D0\uC11C\uB294 \uC791\uC740
      \uAC83 \uD558\uB098\uAC00 \uD070 \uC704\uC548\uC774 \uB418\uC9C0\uC694.\" :
      \"\uC18C\uBC15\uD558\uC9C0\uB9CC \uC815\uC774 \uAC00\uB294 \uBB3C\uAC74\uC774\uAD70\uC694.\"}}}
      {price}\uACE8\uB4DC\uB97C \uB4DC\uB824\uB3C4 \uB420\uAE4C\uC694?"
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uB208\uC5D0 \uB4E4\uC5B4\uC654\uC2B5\uB2C8\uB2E4.
      \uAE38\uC744 \uB098\uC11C\uAE30 \uC804\uC5D0 \uC774\uB7F0 \uC778\uC5F0\uC774
      \uB2FF\uB2E4\uB2C8\uC694. {price}\uACE8\uB4DC\uB97C \uC62C\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uB098 \uC788\uAD70\uC694. \uAE38\uB3D9\uBB34\uB4E4\uACFC
      \uB098\uB204\uC5B4 \uC9C0\uB2C8\uACA0\uC2B5\uB2C8\uB2E4. \uBAA8\uB450 \uD569\uCCD0
      {price}\uACE8\uB4DC\uB294 \uC5B4\uB5BB\uACA0\uC2B5\uB2C8\uAE4C?\" : \"\uD558\uB098\uBA74
      \uC871\uD569\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB97C \uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{groupName}\uC758 {npcName}\uC785\uB2C8\uB2E4. \uC624\uB79C \uAC78\uC74C
      \uB05D\uC5D0 \uC774\uB7F0 \uBB3C\uAC74\uC744 \uB9CC\uB0AC\uAD70\uC694. {itemName}\uC5D0
      {price}\uACE8\uB4DC\uB97C \uB4DC\uB9AC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == sword ? \"\uAC80\uC744 \uC958 \uC77C\uC774 \uC5C6\uAE38 \uBC14\uB77C\uC9C0\uB9CC,
      \uC5B4\uB450\uC6B4 \uAE38\uC5D0\uC11C\uB294 \uC758\uC9C0\uAC00 \uB418\uACA0\uC9C0\uC694.\"
      : {itemType == bow ? \"\uD65C\uC774\uAD70\uC694. \uC9D0\uC2B9\uC774 \uC6B0\uB294
      \uBC24\uAE38\uC5D0 \uACC1\uC5D0 \uC788\uC73C\uBA74 \uB4E0\uB4E0\uD558\uACA0\uC2B5\uB2C8\uB2E4.\"
      : \"\uAE38\uC744 \uAC77\uB294 \uC774\uC5D0\uAC8C\uB294 \uC774\uB7F0 \uB3D9\uD589\uC774
      \uBC18\uAC11\uC2B5\uB2C8\uB2E4.\"}} {price}\uACE8\uB4DC, \uBC1B\uC544 \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - speakerId: 0
    text: "{price >= baseValue ? \"\uC81C \uBAAB\uC5D0 \uC870\uAE08 \uB354 \uC5B9\uC5C8\uC2B5\uB2C8\uB2E4.
      \uC88B\uC740 \uC778\uC5F0\uC5D0\uB294 \uD6C4\uD558\uAC8C \uD574\uC57C\uC9C0\uC694.
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : \"\uAC00\uC9C4 \uAC83\uC774 \uB109\uB109\uC9C0
      \uC54A\uC544 {price}\uACE8\uB4DC\uBC16\uC5D0 \uBABB \uB4DC\uB9BD\uB2C8\uB2E4.
      \uD5E4\uC544\uB824 \uC8FC\uC2ED\uC2DC\uC624.\"}"
  - speakerId: 0
    text: "\uBC1C\uC5D0 \uBB3C\uC9D1\uC774 \uD130\uC838\uB3C4 \uAC78\uC74C\uC744
      \uBA48\uCD9C \uC218 \uC5C6\uB294 \uAE38\uC774\uB77C, \uB9C8\uC74C \uAE30\uB308
      \uBB3C\uAC74\uC774 \uD544\uC694\uD588\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB97C
      \uB4DC\uB9BD\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemElement == holy ? \"\uC2E0\uC131\uD55C \uAE30\uC6B4\uC774 \uAE43\uB4E4\uC5B4
      \uC788\uAD70\uC694. \uC774\uB7F0 \uBB3C\uAC74\uC740 \uAC12\uC744 \uB530\uC9C0\uAE30\uAC00
      \uC1A1\uAD6C\uD569\uB2C8\uB2E4\uB9CC, {price}\uACE8\uB4DC\uB97C \uC62C\uB9BD\uB2C8\uB2E4.\"
      : \"{price}\uACE8\uB4DC\uB97C \uB4DC\uB9BD\uB2C8\uB2E4. \uB9C8\uC74C\uC744
      \uB2F4\uC558\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "\uC0C8\uBCBD \uC11C\uB9AC\uAC00 \uB0B4\uB9AC\uAE30 \uC804\uC5D0 \uAE38\uC744
      \uB098\uC11C\uC57C \uD569\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB85C \uC815\uD574
      \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC\uB85C\uAD70\uC694. \uBD80\uC801
      \uB300\uC2E0 \uD488\uC5D0 \uB123\uACE0 \uB2E4\uB2C8\uAE30 \uC88B\uACA0\uC2B5\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uB294 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\" : {itemType ==
      rune ? \"\uB8EC\uC774\uAD70\uC694. \uD488\uC5D0 \uB123\uACE0 \uAC78\uC73C\uBA74
      \uB9C8\uC74C\uC774 \uB193\uC774\uACA0\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB294
      \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\" : \"\uBE5B\uC774 \uB2FF\uC740 \uC778\uC5F0\uC774\uB77C
      \uBBFF\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB294 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\"}}"
  _negotiation:
  - speakerId: 0
    text: "{prevPrice}\uACE8\uB4DC\uC5D0\uC11C {price}\uACE8\uB4DC\uB85C \uC62C\uB9BD\uB2C8\uB2E4.
      \uAE38\uB3D9\uBB34\uB4E4\uC758 \uBAAB\uC744 \uC870\uAE08 \uB35C\uC5B4\uC11C
      \uB9D0\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"{askPrice}\uACE8\uB4DC\uB294 \uC800\uD76C\uC5D0\uAC8C
      \uB108\uBB34 \uD070 \uC22B\uC790\uC785\uB2C8\uB2E4. \uADF8\uB798\uB3C4 {price}\uACE8\uB4DC\uAE4C\uC9C0\uB294
      \uB9C8\uC74C\uC744 \uC5F4\uACA0\uC2B5\uB2C8\uB2E4.\" : \"{askPrice}\uACE8\uB4DC\uB294
      \uC870\uAE08 \uBC85\uCC28\uAD70\uC694. {price}\uACE8\uB4DC\uB85C \uB9DE\uCDB0
      \uC8FC\uC2E4 \uC218 \uC788\uACA0\uC2B5\uB2C8\uAE4C?\"}"
  - speakerId: 0
    text: "{bargainCount >= 2 ? \"\uC5EC\uB7EC \uBC88 \uB9D0\uC500\uC744 \uB098\uB204\uAC8C
      \uB418\uC5C8\uAD70\uC694. \uC774\uAC83\uB3C4 \uC778\uC5F0\uC774\uACA0\uC9C0\uC694.
      {price}\uACE8\uB4DC\uB85C \uB9C8\uC74C\uC744 \uBAA8\uC74D\uB2C8\uB2E4.\" :
      \"\uD55C \uAC78\uC74C \uB354 \uB2E4\uAC00\uAC00\uACA0\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB294
      \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\"}"
  - speakerId: 0
    text: "{priceGap}\uACE8\uB4DC\uC758 \uAC04\uACA9\uC740 \uC11C\uB85C \uD55C \uAC78\uC74C\uC529
      \uC591\uBCF4\uD558\uBA74 \uBA54\uC6CC\uC9C0\uB9AC\uB77C \uBBFF\uC2B5\uB2C8\uB2E4.
      \uC800\uB294 {price}\uACE8\uB4DC\uAE4C\uC9C0 \uAC00\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uBA74 \uAC1C\uB2F9 {unitPrice}\uACE8\uB4DC\uAF34\uC774\uAD70\uC694.
      \uBAA8\uC544\uC11C {price}\uACE8\uB4DC\uB294 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\"
      : \"\uD558\uB098\uBFD0\uC778 \uBB3C\uAC74\uC774\uB2C8 \uC18C\uC911\uD788 \uC9C0\uB2C8\uACA0\uC2B5\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uB294 \uC5B4\uB5BB\uC2B5\uB2C8\uAE4C?\"}"
  - speakerId: 0
    text: "{itemElement == holy ? \"\uC2E0\uC131\uD55C \uAE30\uC6B4\uC5D0\uB294 \uAC12\uC744
      \uB354 \uB4DC\uB824\uC57C \uB9C8\uB545\uD558\uC9C0\uC694. {price}\uACE8\uB4DC\uAE4C\uC9C0
      \uC62C\uB9BD\uB2C8\uB2E4.\" : {itemType == rune ? \"\uBD80\uC801\uCC98\uB7FC
      \uACC1\uC5D0 \uB458 \uC218 \uC788\uB2E4\uBA74 \uAC12\uC744 \uB354 \uB4DC\uB9B4
      \uB9CC\uD569\uB2C8\uB2E4. {price}\uACE8\uB4DC\uAE4C\uC9C0 \uC62C\uB9BD\uB2C8\uB2E4.\"
      : \"{itemName}\uC5D0 \uC815\uC774 \uAC00\uB294\uAD70\uC694. {price}\uACE8\uB4DC\uAE4C\uC9C0
      \uC62C\uB9BD\uB2C8\uB2E4.\"}}"
  - speakerId: 0
    text: "{price >= baseValue ? \"\uC81C\uAC12\uC740 \uC774\uBBF8 \uB118\uACBC\uC73C\uB2C8
      \uBD80\uB514 \uD5E4\uC544\uB824 \uC8FC\uC2ED\uC2DC\uC624. {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"
      : \"{price}\uACE8\uB4DC\uBA74 \uC11C\uB85C \uB9C8\uC74C\uC774 \uC0C1\uD558\uC9C0
      \uC54A\uB294 \uC120\uC774\uB77C \uBBFF\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{npcName}(\uC740/\uB294) \uC695\uC2EC\uC744 \uB0B4\uB294 \uC77C\uC774
      \uC11C\uD23D\uB2C8\uB2E4. \uADF8\uB798\uB3C4 {price}\uACE8\uB4DC\uAE4C\uC9C0\uB294
      \uB4DC\uB9AC\uACE0 \uC2F6\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "\uAE38 \uC704\uC5D0\uC11C \uC4F0\uB294 \uB3C8\uC740 \uD55C \uD47C\uC774
      \uADC0\uD569\uB2C8\uB2E4. {price}\uACE8\uB4DC\uAC00 \uC81C \uC815\uC131\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "\uB2E4\uD23C\uC740 \uB9C8\uC74C\uC744 \uC5B4\uB461\uAC8C \uD558\uC9C0\uC694.
      {price}\uACE8\uB4DC\uB85C \uD658\uD558\uAC8C \uB05D\uB0B4\uBA74 \uC5B4\uB5BB\uACA0\uC2B5\uB2C8\uAE4C?"
  _finalOffer:
  - speakerId: 0
    text: "\uC774\uAC83\uC774 \uB9C8\uC9C0\uB9C9 \uCCAD\uC785\uB2C8\uB2E4. {price}\uACE8\uB4DC,
      \uB354\uB294 \uC62C\uB9B4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{firstPrice}\uACE8\uB4DC\uC5D0\uC11C {price}\uACE8\uB4DC\uAE4C\uC9C0 \uC654\uC2B5\uB2C8\uB2E4.
      \uC81C \uC815\uC131\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "{price}\uACE8\uB4DC\uC785\uB2C8\uB2E4. \uC774 \uC774\uC0C1\uC740 \uB178\uC7A3\uB3C8\uC5D0
      \uC190\uC744 \uB300\uC57C \uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC804\uBD80\uC5D0 {price}\uACE8\uB4DC\uAC00
      \uC81C \uD55C\uB3C4\uC785\uB2C8\uB2E4.\" : \"\uD558\uB098\uC5D0 {price}\uACE8\uB4DC\uAC00
      \uC81C \uD55C\uB3C4\uC785\uB2C8\uB2E4.\"} \uBD80\uB514 \uBC1B\uC544 \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uAC10\uB2F9\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uB85C \uD5C8\uB77D\uD574 \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{npcName}\uC758 \uB9C8\uC9C0\uB9C9 \uCCAD\uC785\uB2C8\uB2E4. {price}\uACE8\uB4DC,
      \uBD80\uB514 \uBC1B\uC544 \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC\uC5D0 \uC774 \uC774\uC0C1 \uC4F0\uBA74
      \uAE38\uC744 \uB5A0\uB0A0 \uCC44\uBE44\uB97C \uBABB \uD569\uB2C8\uB2E4.\" :
      {itemType == rune ? \"\uB8EC\uC774 \uD0D0\uB098\uC9C0\uB9CC \uC774 \uC774\uC0C1\uC740
      \uD615\uD3B8\uC774 \uD5C8\uB77D\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\" : \"\uD0D0\uB098\uC9C0\uB9CC
      \uC774 \uC774\uC0C1\uC740 \uD615\uD3B8\uC774 \uD5C8\uB77D\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\"}}
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"{priceGap}\uACE8\uB4DC\uB098 \uBC8C\uC5B4\uC84C\uAD70\uC694.
      \uC81C \uD798\uC73C\uB85C\uB294 \uBA54\uC6B8 \uAE38\uC774 \uC5C6\uC2B5\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uAC00 \uB05D\uC785\uB2C8\uB2E4.\" : \"{price}\uACE8\uB4DC\uB85C
      \uC815\uD558\uBA74 \uC88B\uACA0\uC2B5\uB2C8\uB2E4. \uC774 \uC815\uB3C4 \uCC28\uC774\uB294
      \uBE5B\uC774 \uB36E\uC5B4 \uC8FC\uACA0\uC9C0\uC694.\"}"
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uB9C8\uC74C\uC5D0 \uAC78\uB9AC\uC9C0\uB9CC
      \uC695\uC2EC\uC774 \uC9C0\uB098\uCE58\uBA74 \uAE38\uC744 \uC783\uC2B5\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "\uD574\uAC00 \uB728\uAE30 \uC804\uC5D0 \uCD9C\uBC1C\uD574\uC57C \uD569\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uB85C \uB2F5\uD574 \uC8FC\uC2DC\uACA0\uC2B5\uB2C8\uAE4C?"
  _acception:
  - speakerId: 0
    text: "\uAC10\uC0AC\uD569\uB2C8\uB2E4. \uC624\uB298 \uAC78\uC74C\uC774 \uD55C\uACB0
      \uAC00\uBCCD\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemElement == holy ? \"\uC774 \uB9D1\uC740 \uAE30\uC6B4\uC744 \uD488\uACE0
      \uAC78\uC73C\uBA74 \uC5B4\uB5A4 \uBC24\uAE38\uB3C4 \uB450\uB835\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\"
      : {itemType == rune ? \"\uD488\uC5D0 \uC9C0\uB2C8\uBA74 \uBD80\uC801 \uAC19\uACA0\uC2B5\uB2C8\uB2E4.\"
      : {itemType == consumable ? \"\uC774\uB9CC\uD07C\uC774\uBA74 \uBA3C \uAE38\uB3C4
      \uB4E0\uB4E0\uD569\uB2C8\uB2E4.\" : \"\uC88B\uC740 \uC778\uC5F0\uC774\uC5C8\uC2B5\uB2C8\uB2E4.\"}}}"
  - speakerId: 0
    text: "{price}\uACE8\uB4DC, \uC5EC\uAE30 \uC788\uC2B5\uB2C8\uB2E4. \uCC9C\uCC9C\uD788
      \uC138\uC5B4 \uBCF4\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{itemName}(\uC744/\uB97C) \uD488\uC5D0 \uC548\uACE0 \uAC00\uACA0\uC2B5\uB2C8\uB2E4.
      \uAE38\uB3D9\uBB34\uB4E4\uC774 \uAE30\uBED0\uD558\uACA0\uAD70\uC694."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uBAA8\uB450 \uC798 \uAC04\uC9C1\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uAE38\uB3D9\uBB34\uB4E4\uACFC \uB098\uB204\uACA0\uC2B5\uB2C8\uB2E4.\" : \"\uC18C\uC911\uD788
      \uAC04\uC9C1\uD558\uACA0\uC2B5\uB2C8\uB2E4.\"} \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "\uC624\uB298 \uB9CC\uB09C \uC778\uC5F0\uC5D0 \uAC10\uC0AC\uB4DC\uB9BD\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC758 \uC55E\uAE38\uC5D0\uB3C4 \uBE5B\uC774 \uB2FF\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4."
  - speakerId: 0
    text: "{groupName}(\uC740/\uB294) \uBC1B\uC740 \uC815\uC744 \uC78A\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC74C \uAE38\uC5D0\uB3C4 \uAE30\uC5B5\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{npcName}, \uC624\uB298\uC758 \uC740\uD61C\uB97C \uB9C8\uC74C\uC5D0 \uC0C8\uAE30\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{price >= baseValue ? \"\uC81C\uAC12\uBCF4\uB2E4 \uB354 \uB4DC\uB838\uC5B4\uB3C4
      \uB9C8\uC74C\uC774 \uAC00\uBCCD\uC2B5\uB2C8\uB2E4. \uC88B\uC740 \uC77C\uC774\uC5C8\uC73C\uB2C8\uAE4C\uC694.\"
      : \"\uC81C\uAC12\uC5D0 \uB9DE\uAC8C \uB418\uC5B4 \uB9C8\uC74C\uC774 \uD3B8\uD569\uB2C8\uB2E4.\"}
      \uACE0\uB9D9\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "\uC0C8\uBCBD\uBE5B\uC774 \uB354 \uD658\uD558\uAC8C \uB290\uAEF4\uC9C0\uB294\uAD70\uC694.
      \uACE0\uB9D9\uC2B5\uB2C8\uB2E4."
  _rejection:
  - speakerId: 0
    text: "\uC544\uC27D\uC9C0\uB9CC \uC774\uBC88 \uC778\uC5F0\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC778
      \uB4EF\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uC800\uD76C \uD615\uD3B8\uC73C\uB85C\uB294
      \uB2FF\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. \uB9C8\uC74C\uB9CC \uB450\uACE0
      \uAC00\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uB97C \uD488\uACE0 \uAC00\uACE0 \uC2F6\uC5C8\uB294\uB370,
      \uAC12\uC774 \uB9DE\uC9C0 \uC54A\uB294\uAD70\uC694.\" : \"\uAF2D \uC9C0\uB2C8\uACE0
      \uC2F6\uC5C8\uB294\uB370, \uAC12\uC774 \uB9DE\uC9C0 \uC54A\uB294\uAD70\uC694.\"}
      \uC544\uC27D\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uCC38\uC73C\uB85C \uC544\uC27D\uAD70\uC694.
      \uC778\uC5F0\uC774 \uB2FF\uC73C\uBA74 \uB2E4\uC2DC \uB9CC\uB098\uACA0\uC9C0\uC694."
  - speakerId: 0
    text: "{itemElement == holy ? \"\uC2E0\uC131\uD55C \uAE30\uC6B4\uC744 \uB193\uCE58\uB294
      \uAC83\uC774 \uB9C8\uC74C\uC5D0 \uAC78\uB9AC\uC9C0\uB9CC, \uC695\uC2EC\uB0B4\uC9C0
      \uC54A\uACA0\uC2B5\uB2C8\uB2E4.\" : {itemType == rune ? \"\uD488\uC5D0 \uC9C0\uB2D0
      \uC218 \uC788\uC5C8\uC73C\uBA74 \uD588\uB294\uB370, \uAE38\uC774 \uB2E4\uB978\uAC00
      \uBD05\uB2C8\uB2E4.\" : \"\uC778\uC5F0\uC774 \uC544\uB2C8\uC5C8\uB098 \uBD05\uB2C8\uB2E4.\"}}"
  - speakerId: 0
    text: "{groupName}(\uC740/\uB294) \uB2E4\uD23C\uC73C\uB85C \uAE38\uC744 \uD750\uB9AC\uC9C0
      \uC54A\uC2B5\uB2C8\uB2E4. \uD3C9\uC548\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4."
  - speakerId: 0
    text: "{npcName}(\uC740/\uB294) \uC774\uB9CC \uAE38\uC744 \uB098\uC11C\uACA0\uC2B5\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC5D0\uAC8C\uB3C4 \uBE5B\uC774 \uD568\uAED8\uD558\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == sword ? \"\uAC80\uC740 \uB2E4\uB978 \uC774\uC758 \uBAAB\uC774\uC5C8\uB358
      \uBAA8\uC591\uC785\uB2C8\uB2E4. \uD3C9\uC548\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4.\"
      : {itemType == bow ? \"\uD65C\uC740 \uB2E4\uB978 \uC774\uC758 \uBAAB\uC774\uC5C8\uB358
      \uBAA8\uC591\uC785\uB2C8\uB2E4. \uD3C9\uC548\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4.\"
      : \"\uC774 \uBB3C\uAC74\uC740 \uB2E4\uB978 \uC774\uC758 \uBAAB\uC774\uC5C8\uB358
      \uBAA8\uC591\uC785\uB2C8\uB2E4. \uD3C9\uC548\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4.\"}}"
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"\uADF8\uB9CC\uD55C \uAC12\uC774\uB77C\uBA74 \uC800\uD76C\uAC00
      \uB2FF\uC744 \uC218 \uC5C6\uB294 \uBB3C\uAC74\uC774\uAD70\uC694. \uB9C8\uC74C\uC744
      \uC811\uACA0\uC2B5\uB2C8\uB2E4.\" : \"\uC870\uAE08\uB9CC \uB354 \uB9DE\uC558\uB2E4\uBA74
      \uC88B\uC558\uC744 \uD150\uB370\uC694. \uD3C9\uC548\uD558\uC2DC\uAE38 \uBC14\uB78D\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "\uC0C8\uBCBD\uC774 \uC624\uAE30 \uC804\uC5D0 \uAE38\uC744 \uB098\uC11C\uC57C
      \uD558\uB2C8 \uC774\uB9CC \uAC00\uACA0\uC2B5\uB2C8\uB2E4. \uD3C9\uC548\uD558\uC2ED\uC2DC\uC624."
  _minTimer: 90
  _maxTimer: 170
