  _firstOffer:
  - speakerId: 0
    text: "{itemType == sword ? \"\uAC80\uC5D0\uC11C \uB9C8\uB825\uC758 \uD750\uB984\uC774
      \uB290\uAEF4\uC838\uC694!\" : {itemType == bow ? \"\uD65C\uC5D0 \uB9C8\uB825\uC774
      \uD750\uB974\uB294 \uAC8C \uB290\uAEF4\uC838\uC694!\" : {itemType == rune ?
      \"\uB8EC\uC758 \uB9C8\uB825 \uBC18\uC751\uC774 \uC815\uB9D0 \uC120\uBA85\uD574\uC694!\"
      : {itemType == material ? \"\uC7AC\uB8CC\uC758 \uB9C8\uB825 \uACB0\uC815 \uC0C1\uD0DC\uAC00
      \uB180\uB77C\uC6CC\uC694!\" : \"\uC774 \uBB3C\uAC74, \uB9C8\uB825\uC758 \uACB0\uC774
      \uC815\uB9D0 \uD765\uBBF8\uB85C\uC6CC\uC694!\"}}}} {price}\uACE8\uB4DC\uBA74
      \uB420\uAE4C\uC694?"
  - speakerId: 0
    text: "{itemElement == flame ? \"\uBD88\uC758 \uC6D0\uC18C \uBC18\uC751\uC774
      \uC774\uB807\uAC8C \uC120\uBA85\uD558\uB2E4\uB2C8!\" : {itemElement == cold
      ? \"\uB0C9\uAE30\uC758 \uC751\uACB0\uC774 \uC815\uB9D0 \uC544\uB984\uB2E4\uC6CC\uC694!\"
      : {itemElement == lightning ? \"\uBC88\uAC1C \uAE30\uC6B4\uC774 \uD280\uB294
      \uAC83 \uC880 \uBCF4\uC138\uC694!\" : {itemElement == wind ? \"\uBC14\uB78C\uC758
      \uACF5\uBA85\uC774 \uADD3\uAC00\uC5D0 \uB4E4\uB9AC\uB294 \uAC83 \uAC19\uC544\uC694!\"
      : {itemElement == earth ? \"\uB300\uC9C0\uC758 \uC6D0\uC18C\uAC00 \uBB35\uC9C1\uD558\uAC8C
      \uC6B8\uB824\uC694!\" : {itemElement == holy ? \"\uC2E0\uC131\uD55C \uAE30\uC6B4\uC774
      \uB9D1\uAC8C \uD37C\uC9C0\uB124\uC694!\" : {itemElement == dark ? \"\uC5B4\uB460\uC758
      \uAE30\uC6B4\uC774 \uC774\uB807\uAC8C \uAE4A\uB2E4\uB2C8, \uD765\uBBF8\uB85C\uC6CC\uC694!\"
      : \"\uB9C8\uB825\uC758 \uD750\uB984\uC774 \uC815\uB9D0 \uD765\uBBF8\uB85C\uC6CC\uC694!\"}}}}}}}
      {price}\uACE8\uB4DC, \uC774 \uC815\uB3C4\uBA74 \uB418\uACA0\uC8E0?"
  - speakerId: 0
    text: "{price}\uACE8\uB4DC \uB4DC\uB9B4\uAC8C\uC694. \uAE08\uC561\uC740 \uC798
      \uBAA8\uB974\uACA0\uC9C0\uB9CC, \uC5F0\uAD6C\uC5D0 \uBCF4\uD0EC\uC774 \uB418\uBA74
      \uADF8\uAC78\uB85C \uCDA9\uBD84\uD574\uC694!"
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uB098 \uC788\uB2E4\uB2C8, \uBE44\uAD50
      \uC5F0\uAD6C\uAC00 \uAC00\uB2A5\uD558\uACA0\uC5B4\uC694! \uC804\uBD80 \uD569\uCCD0
      {price}\uACE8\uB4DC \uC5B4\uB54C\uC694?\" : \"\uB531 \uD558\uB098\uB77C \uB354
      \uC18C\uC911\uD558\uB124\uC694! {price}\uACE8\uB4DC \uC5B4\uB54C\uC694?\"}"
  - speakerId: 0
    text: "\uC800\uB294 {groupName}\uC758 {npcName}. {itemName}\uC5D0 {price}\uACE8\uB4DC\uB97C
      \uB4DC\uB9AC\uACE0 \uC2F6\uC5B4\uC694!"
  - speakerId: 0
    text: "{price >= baseValue ? \"{baseValue}\uACE8\uB4DC\uAC00 \uAE30\uBCF8 \uAC00\uCE58\uB77C\uB358\uB370,
      \uC774 \uC815\uB3C4 \uBB3C\uAC74\uC774\uBA74 \uB354 \uB4DC\uB824\uC57C\uC8E0.
      {price}\uACE8\uB4DC \uC5B4\uB54C\uC694?\" : \"{itemName}\uC758 \uAC00\uCE58\uB97C
      \uC81C\uB300\uB85C \uBAA8\uB974\uACA0\uC5B4\uC11C... \uC77C\uB2E8 {price}\uACE8\uB4DC
      \uC5B4\uB54C\uC694?\"}"
  - speakerId: 0
    text: "{itemName}(\uC744/\uB97C) \uBCF4\uC790\uB9C8\uC790 \uAC00\uC2B4\uC774
      \uB6F0\uC5C8\uC5B4\uC694! {price}\uACE8\uB4DC, \uBC1B\uC544\uC8FC\uC2E4\uB798\uC694?"
  - speakerId: 0
    text: "{itemType == material ? \"\uC774 \uC7AC\uB8CC\uB85C \uC2E4\uD5D8\uD574
      \uBCF4\uACE0 \uC2F6\uC740 \uAC8C \uC0B0\uB354\uBBF8\uC608\uC694! {price}\uACE8\uB4DC\uBA74
      \uB420\uAE4C\uC694?\" : {itemType == rune ? \"\uC774 \uB8EC\uC744 \uD574\uC11D\uD574
      \uBCFC \uC0DD\uAC01\uC744 \uD558\uB2C8 \uC124\uB808\uC694! {price}\uACE8\uB4DC\uBA74
      \uB420\uAE4C\uC694?\" : \"\uC5F0\uAD6C\uD574 \uBCFC \uC0DD\uAC01\uC744 \uD558\uB2C8
      \uC124\uB808\uC694! {price}\uACE8\uB4DC\uBA74 \uB420\uAE4C\uC694?\"}}"
  - speakerId: 0
    text: "\uD559\uC790\uC758 \uB208\uC73C\uB85C \uBCF4\uBA74 \uB193\uCE60 \uC218
      \uC5C6\uB294 \uBB3C\uAC74\uC774\uC5D0\uC694. {price}\uACE8\uB4DC\uB97C \uB4DC\uB9B4\uAC8C\uC694!"
  - speakerId: 0
    text: "\uAC12\uC740 \uC798 \uBAB0\uB77C\uC11C\uC694... {price}\uACE8\uB4DC\uBA74
      \uC801\uB2F9\uD55C\uAC00\uC694? \uBD80\uC871\uD558\uBA74 \uB9D0\uC500\uD574
      \uC8FC\uC138\uC694!"
  _negotiation:
  - speakerId: 0
    text: "\uC544, \uADF8 \uC815\uB3C4\uBA74 \uB420\uAE4C\uC694? {price}\uACE8\uB4DC\uAE4C\uC9C0
      \uC62C\uB824 \uBCFC\uAC8C\uC694!"
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uC694? \uADF8\uB9CC\uD55C \uAC00\uCE58\uAC00 \uC788\uACA0\uC8E0!
      {prevPrice}\uACE8\uB4DC\uC5D0\uC11C {price}\uACE8\uB4DC\uB85C \uC62C\uB9B4\uAC8C\uC694."
  - speakerId: 0
    text: "{bargainCount >= 2 ? \"\uACC4\uC18D \uC62C\uB9AC\uACE0 \uC788\uB294\uB370
      \uB9DE\uB294 \uAC74\uAC00\uC694? \uC5B4\uCA0C\uB4E0 {price}\uACE8\uB4DC \uB4DC\uB9B4\uAC8C\uC694!\"
      : \"{price}\uACE8\uB4DC\uB85C \uC5B4\uB54C\uC694? \uAE08\uC561\uC5D0 \uC11C\uD234\uB7EC\uC11C
      \uBD80\uC871\uD558\uBA74 \uB9D0\uC500\uD574 \uC8FC\uC138\uC694.\"}"
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"\uAF64 \uB192\uAC8C \uBD80\uB974\uC168\uC9C0\uB9CC
      \uC774\uB7F0 \uBB3C\uAC74\uC774\uB77C\uBA74 \uADF8\uB7F4 \uB9CC\uD558\uC8E0.
      {price}\uACE8\uB4DC\uB85C \uB9DE\uCDB0 \uBCFC\uAC8C\uC694!\" : \"\uADF8 \uC815\uB3C4\uB294
      \uCDA9\uBD84\uD788 \uB0BC \uB9CC\uD574\uC694. {price}\uACE8\uB4DC\uB85C \uD560\uAC8C\uC694!\"}"
  - speakerId: 0
    text: "{itemElement == flame ? \"\uBD88 \uC6D0\uC18C \uBC18\uC751\uC744 \uB354
      \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\" : {itemElement == cold ? \"\uB0C9\uAE30 \uBC18\uC751\uC744
      \uB354 \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\" : {itemElement == lightning ? \"\uBC88\uAC1C
      \uBC18\uC751\uC744 \uB354 \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\" : {itemElement
      == wind ? \"\uBC14\uB78C \uBC18\uC751\uC744 \uB354 \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\"
      : {itemElement == earth ? \"\uB300\uC9C0 \uBC18\uC751\uC744 \uB354 \uBCF4\uACE0
      \uC2F6\uC73C\uB2C8\" : {itemElement == holy ? \"\uC2E0\uC131 \uBC18\uC751\uC744
      \uB354 \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\" : {itemElement == dark ? \"\uC5B4\uB460
      \uBC18\uC751\uC744 \uB354 \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\" : \"\uB354 \uC5F0\uAD6C\uD574
      \uBCF4\uACE0 \uC2F6\uC73C\uB2C8\"}}}}}}} {price}\uACE8\uB4DC\uAE4C\uC9C0 \uB4DC\uB9B4\uAC8C\uC694!"
  - speakerId: 0
    text: "{priceGap}\uACE8\uB4DC \uC815\uB3C4 \uCC28\uC774\uC57C \uC5F0\uAD6C \uC131\uACFC\uC5D0
      \uBE44\uD558\uBA74 \uC791\uC740 \uAC70\uC8E0. {price}\uACE8\uB4DC\uB85C \uD560\uAC8C\uC694!"
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uBA74 \uAC1C\uB2F9 {unitPrice}\uACE8\uB4DC\uB124\uC694.
      \uC804\uBD80 \uD569\uCCD0 {price}\uACE8\uB4DC\uB85C \uD560\uAC8C\uC694!\" :
      \"\uD558\uB098\uBFD0\uC778 \uBB3C\uAC74\uC774\uB2C8 {price}\uACE8\uB4DC\uB85C
      \uD560\uAC8C\uC694!\"}"
  - speakerId: 0
    text: "{price >= baseValue ? \"{baseValue}\uACE8\uB4DC \uC774\uC0C1\uC740 \uB4DC\uB824\uC57C
      \uC608\uC758\uC8E0. {price}\uACE8\uB4DC \uC5B4\uB54C\uC694?\" : \"{price}\uACE8\uB4DC\uBA74
      \uC5B4\uB54C\uC694? \uC870\uAE08 \uBD80\uC871\uD55C\uAC00\uC694?\"}"
  - speakerId: 0
    text: "{npcName}(\uC740/\uB294) \uACC4\uC0B0\uC5D0 \uC57D\uD574\uC11C\uC694...
      \uADF8\uB798\uB3C4 {price}\uACE8\uB4DC\uBA74 \uB418\uACA0\uC8E0?"
  - speakerId: 0
    text: "{itemName}(\uC744/\uB97C) \uC5F0\uAD6C\uD560 \uC218 \uC788\uB2E4\uBA74
      {price}\uACE8\uB4DC\uCBE4\uC774\uC57C! \uC774 \uC815\uB3C4\uB85C \uC5B4\uB5A0\uC138\uC694?"
  _finalOffer:
  - speakerId: 0
    text: "\uC8C4\uC1A1\uD574\uC694, \uC5F0\uAD6C\uBE44 \uD55C\uB3C4\uAC00 \uC5EC\uAE30\uAE4C\uC9C0\uC608\uC694.
      {price}\uACE8\uB4DC, \uBD80\uD0C1\uB4DC\uB824\uC694!"
  - speakerId: 0
    text: "{firstPrice}\uACE8\uB4DC\uC5D0\uC11C {price}\uACE8\uB4DC\uAE4C\uC9C0 \uC62C\uB838\uC5B4\uC694.
      \uC774\uAC8C \uC81C \uD55C\uB3C4\uC608\uC694, \uC815\uB9D0\uB85C\uC694!"
  - speakerId: 0
    text: "\uC774 \uC774\uC0C1\uC740 \uC5F0\uAD6C\uBE44 \uD3B8\uC131\uC774 \uC548
      \uB3FC\uC694... {price}\uACE8\uB4DC, \uC5B4\uB5A0\uC138\uC694?"
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uB97C \uD55C\uAEBC\uBC88\uC5D0 {price}\uACE8\uB4DC,
      \uC774\uAC8C \uCD5C\uC120\uC774\uC5D0\uC694!\" : \"\uD558\uB098\uC5D0 {price}\uACE8\uB4DC,
      \uC774\uAC8C \uCD5C\uC120\uC774\uC5D0\uC694!\"} \uBD80\uD0C1\uB4DC\uB824\uC694."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uC5F0\uAD6C\uBE44\uB85C \uAC10\uB2F9\uC774
      \uC548 \uB3FC\uC694. {price}\uACE8\uB4DC\uB85C \uBD80\uD0C1\uB4DC\uB824\uC694!"
  - speakerId: 0
    text: "{npcName}\uC758 \uB9C8\uC9C0\uB9C9 \uC81C\uC548\uC774\uC5D0\uC694. {price}\uACE8\uB4DC,
      \uBC1B\uC544\uC8FC\uC2DC\uBA74 \uC815\uB9D0 \uAC10\uC0AC\uD558\uACA0\uC5B4\uC694!"
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC \uD558\uB098\uC5D0 \uC774 \uC774\uC0C1\uC740
      \uC5F0\uAD6C\uBE44\uAC00 \uD5C8\uB77D\uD558\uC9C0 \uC54A\uC544\uC694.\" : {itemType
      == rune ? \"\uB8EC \uD558\uB098\uC5D0 \uC774 \uC774\uC0C1\uC740 \uC5F0\uAD6C\uBE44\uAC00
      \uD5C8\uB77D\uD558\uC9C0 \uC54A\uC544\uC694.\" : \"\uC774 \uBB3C\uAC74 \uD558\uB098\uC5D0
      \uC774 \uC774\uC0C1\uC740 \uC5F0\uAD6C\uBE44\uAC00 \uD5C8\uB77D\uD558\uC9C0
      \uC54A\uC544\uC694.\"}} {price}\uACE8\uB4DC\uAC00 \uB9C8\uC9C0\uB9C9\uC774\uC5D0\uC694."
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"{priceGap}\uACE8\uB4DC\uB098 \uCC28\uC774\uAC00 \uB098\uB124\uC694...
      \uC544\uC27D\uC9C0\uB9CC {price}\uACE8\uB4DC\uAC00 \uCD5C\uC120\uC774\uC5D0\uC694!\"
      : \"{price}\uACE8\uB4DC\uB85C \uC548 \uB420\uAE4C\uC694? \uC815\uB9D0 \uC774\uAC8C
      \uCD5C\uC120\uC774\uC5D0\uC694!\"}"
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uD0D0\uB098\uC9C0\uB9CC, \uC5F0\uAD6C\uBE44\uC5D0\uB3C4
      \uB05D\uC774 \uC788\uC5B4\uC694. {price}\uACE8\uB4DC\uAC00 \uB9C8\uC9C0\uB9C9\uC774\uC5D0\uC694."
  - speakerId: 0
    text: "{price}\uACE8\uB4DC\uB85C \uACB0\uC815\uD574 \uC8FC\uC138\uC694. \uC548
      \uB418\uBA74 \uC544\uC27D\uC9C0\uB9CC \uD3EC\uAE30\uD560\uAC8C\uC694..."
  _acception:
  - speakerId: 0
    text: "\uC640, \uC815\uB9D0\uC694?! \uAC10\uC0AC\uD569\uB2C8\uB2E4! \uBC14\uB85C
      \uC5F0\uAD6C\uD574 \uBCFC\uAC8C\uC694!"
  - speakerId: 0
    text: "{itemType == sword ? \"\uC774 \uAC80\uC758 \uB9C8\uB825 \uD750\uB984\uC744
      \uBD84\uC11D\uD558\uACE0 \uC2F6\uC5B4\uC11C \uBABB \uCC38\uACA0\uC5B4\uC694!\"
      : {itemType == bow ? \"\uC774 \uD65C\uC758 \uB9C8\uB825 \uBC18\uC751\uC744
      \uBE68\uB9AC \uBD84\uC11D\uD574 \uBCF4\uACE0 \uC2F6\uC5B4\uC694!\" : \"\uC774
      \uBB3C\uAC74\uC744 \uBE68\uB9AC \uBD84\uC11D\uD574 \uBCF4\uACE0 \uC2F6\uC5B4\uC694!\"}}"
  - speakerId: 0
    text: "{price}\uACE8\uB4DC, \uC5EC\uAE30 \uC788\uC5B4\uC694! \uC815\uD655\uD788
      \uC138\uC5B4 \uC8FC\uC138\uC694!"
  - speakerId: 0
    text: "{itemName}(\uC744/\uB97C) \uC190\uC5D0 \uB123\uB2E4\uB2C8! \uC624\uB298\uC740
      \uC815\uB9D0 \uC6B4\uC774 \uC88B\uC740 \uB0A0\uC774\uC5D0\uC694!"
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC804\uBD80 \uAC00\uC838\uAC08\uAC8C\uC694!
      \uBE44\uAD50 \uC5F0\uAD6C\uAC00 \uAE30\uB300\uB3FC\uC694!\" : \"\uC18C\uC911\uD788
      \uAC00\uC838\uAC08\uAC8C\uC694! \uC5F0\uAD6C\uAC00 \uAE30\uB300\uB3FC\uC694!\"}
      \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - speakerId: 0
    text: "{itemElement == flame ? \"\uBD88 \uC6D0\uC18C\uB97C \uC9C1\uC811 \uB2E4\uB904
      \uBCFC \uC218 \uC788\uB2E4\uB2C8!\" : {itemElement == cold ? \"\uB0C9\uAE30
      \uBC18\uC751\uC744 \uC9C1\uC811 \uAD00\uCC30\uD560 \uC218 \uC788\uB2E4\uB2C8!\"
      : {itemElement == lightning ? \"\uBC88\uAC1C \uBC18\uC751\uC744 \uC9C1\uC811
      \uC77C\uC73C\uCF1C \uBCFC \uC218 \uC788\uB2E4\uB2C8!\" : {itemElement == wind
      ? \"\uBC14\uB78C\uC758 \uACF5\uBA85\uC744 \uC9C1\uC811 \uB4E4\uC5B4 \uBCFC
      \uC218 \uC788\uB2E4\uB2C8!\" : {itemElement == earth ? \"\uB300\uC9C0\uC758
      \uC6B8\uB9BC\uC744 \uC9C1\uC811 \uB290\uAEF4 \uBCFC \uC218 \uC788\uB2E4\uB2C8!\"
      : {itemElement == holy ? \"\uC2E0\uC131\uD55C \uAE30\uC6B4\uC744 \uC9C1\uC811
      \uC811\uD574 \uBCFC \uC218 \uC788\uB2E4\uB2C8!\" : {itemElement == dark ? \"\uC5B4\uB460\uC758
      \uAE30\uC6B4\uC744 \uC9C1\uC811 \uAD00\uCC30\uD560 \uC218 \uC788\uB2E4\uB2C8!\"
      : \"\uC774 \uBB3C\uAC74\uC744 \uC9C1\uC811 \uC5F0\uAD6C\uD560 \uC218 \uC788\uB2E4\uB2C8!\"}}}}}}}
      \uC815\uB9D0 \uAE30\uB300\uB3FC\uC694, \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - speakerId: 0
    text: "{groupName}\uC5D0 \uAC00\uC838\uAC00\uBA74 \uBAA8\uB450 \uB180\uB784 \uAC70\uC608\uC694!
      \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  - speakerId: 0
    text: "{npcName}, \uC774 \uAC70\uB798 \uC624\uB798 \uAE30\uC5B5\uD560\uAC8C\uC694!
      \uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694!"
  - speakerId: 0
    text: "{price >= baseValue ? \"\uAE30\uBCF8 \uAC00\uCE58 \uC774\uC0C1\uC73C\uB85C
      \uCCD0\uB4DC\uB838\uB294\uB370\uB3C4 \uBC1B\uC544 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD574\uC694!\"
      : \"\uC774 \uAC00\uACA9\uC5D0 \uC591\uBCF4\uD574 \uC8FC\uC2DC\uB2E4\uB2C8,
      \uC815\uB9D0 \uAC10\uC0AC\uD574\uC694!\"}"
  - speakerId: 0
    text: "\uD6C4\uD6C4, \uC774\uBC88 \uC5F0\uAD6C\uB294 \uD070 \uC131\uACFC\uAC00
      \uB098\uC62C \uAC83 \uAC19\uC544\uC694! \uAC10\uC0AC\uD569\uB2C8\uB2E4!"
  _rejection:
  - speakerId: 0
    text: "\uC544... \uC815\uB9D0 \uC544\uC26C\uC6CC\uC694. \uC5F0\uAD6C\uBE44\uAC00
      \uBAA8\uC790\uB77C\uB124\uC694."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uB3C4\uC800\uD788 \uB9C8\uB828\uD560 \uC218
      \uC5C6\uC5B4\uC694. \uC544\uC27D\uC9C0\uB9CC \uBB3C\uB7EC\uB0A0\uAC8C\uC694..."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uB098 \uB4E4\uC774\uACE0 \uC2F6\uC5C8\uB294\uB370,
      \uAC12\uC774 \uB9DE\uC9C0 \uC54A\uB124\uC694...\" : \"\uAF2D \uC5F0\uAD6C\uD574
      \uBCF4\uACE0 \uC2F6\uC5C8\uB294\uB370, \uAC12\uC774 \uB9DE\uC9C0 \uC54A\uB124\uC694...\"}
      \uC544\uC26C\uC6CC\uC694."
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uC815\uB9D0 \uD0D0\uB0AC\uB294\uB370... \uC5F0\uAD6C\uBE44\uAC00
      \uB354 \uBAA8\uC774\uBA74 \uB2E4\uC2DC \uC62C\uAC8C\uC694!"
  - speakerId: 0
    text: "{itemElement != none ? \"\uADF8 \uC6D0\uC18C \uBC18\uC751\uC744 \uC9C1\uC811
      \uBCF4\uC9C0 \uBABB\uD558\uB2E4\uB2C8, \uB108\uBB34 \uC544\uC26C\uC6CC\uC694...\"
      : \"\uB9C8\uB825\uC758 \uD750\uB984\uC744 \uBD84\uC11D\uD574 \uBCF4\uC9C0 \uBABB\uD558\uB2E4\uB2C8,
      \uB108\uBB34 \uC544\uC26C\uC6CC\uC694...\"}"
  - speakerId: 0
    text: "{groupName}\uC5D0 \uB3CC\uC544\uAC00\uC11C \uC5F0\uAD6C\uBE44\uB97C \uB354
      \uCCAD\uD574 \uBD10\uC57C\uACA0\uC5B4\uC694. \uB2E4\uC2DC \uC62C\uAC8C\uC694..."
  - speakerId: 0
    text: "{npcName}(\uC740/\uB294) \uC774\uB9CC \uB3CC\uC544\uAC08\uAC8C\uC694.
      \uC774 \uBB3C\uAC74\uC774 \uC88B\uC740 \uC8FC\uC778\uC744 \uB9CC\uB098\uAE38
      \uBC14\uB77C\uC694."
  - speakerId: 0
    text: "{itemType == sword ? \"\uC88B\uC740 \uAC80\uC778\uB370 \uC544\uC27D\uB124\uC694...\"
      : {itemType == bow ? \"\uC88B\uC740 \uD65C\uC778\uB370 \uC544\uC27D\uB124\uC694...\"
      : \"\uC88B\uC740 \uBB3C\uAC74\uC778\uB370 \uC544\uC27D\uB124\uC694...\"}} \uB2E4\uC74C\uC5D0
      \uB610 \uBCFC \uC218 \uC788\uAE38 \uBC14\uB77C\uC694."
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"\uC5ED\uC2DC \uADF8\uB9CC\uD55C \uAC00\uCE58\uC600\uAD70\uC694...
      \uC81C \uD615\uD3B8\uC73C\uB85C\uB294 \uC5B4\uB824\uC6CC\uC694. \uC2E4\uB840\uD588\uC5B4\uC694.\"
      : \"\uC544\uC27D\uC9C0\uB9CC \uC774\uBC88\uC5D4 \uBB3C\uB7EC\uB0A0\uAC8C\uC694.
      \uB2E4\uC74C\uC5D0 \uB610 \uBD10\uC694.\"}"
  - speakerId: 0
    text: "\uC8C4\uC1A1\uD574\uC694, \uC624\uB298\uC740 \uC5EC\uAE30\uAE4C\uC9C0
      \uD560\uAC8C\uC694. \uB610 \uB9CC\uB098\uC694!"
  _minTimer: 0
  _maxTimer: 0
