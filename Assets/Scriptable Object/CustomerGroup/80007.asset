  _customerNames:
  - "\uC5D0\uB4DC\uC6CC\uB4DC"
  - "\uB808\uC624\uD3F4\uB4DC"
  - "\uBCA0\uC544\uD2B8\uB9AC\uC2A4"
  - "\uBE45\uD1A0\uB9AC\uC544"
  - "\uC54C\uD3F0\uC2A4"
  - "\uC0EC\uB86F"
