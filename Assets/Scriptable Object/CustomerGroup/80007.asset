  _customerGroupTitle: "\uBD80\uC720\uD55C \uADC0\uC871"
  _customerGroupName: "\uBCA8\uBCA0\uD2F0\uC544 \uC0AC\uAD50 \uD074\uB7FD"
  _description: "\uB9C9\uB300\uD55C \uC601\uC9C0\uC640 \uC7AC\uB825\uC744 \uC790\uB791\uD558\uB294
    \uD638\uD654 \uC218\uC9D1\uAC00 \uADC0\uC871\uB4E4. \uC608\uC220\uC131\uACFC
    \uD76C\uADC0\uC131\uC774 \uB3CB\uBCF4\uC778\uB2E4\uBA74 \uAC00\uACA9\uD45C\uB97C
    \uBCF4\uC9C0 \uC54A\uACE0 \uC9C0\uAC11\uC744 \uC5F0\uB2E4."
  minEstimateRatio: 1.35
  maxEstimateRatio: 2.3
  minFirstOfferRatio: 0.8
  maxFirstOfferRatio: 1
  minInterpolation: 0.25
  maxInterpolation: 0.45
  minPatience: 45
  maxPatience: 80
  greedSensitivity: 0.6
