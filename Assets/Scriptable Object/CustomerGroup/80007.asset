  - "\uD544\uB9BD"
  - "\uC544\uB378"
  _customerSprites: []
  _firstOffer:
  - speakerId: 0
    text: "{itemType == sword ? \"\uAC80\uC758 \uAE30\uD488\uC774 \uB0A8\uB2E4\uB974\uAD70.\"
      : {itemType == bow ? \"\uD65C\uC758 \uC790\uD0DC\uAC00 \uACF1\uAD70.\" : {itemType
      == rune ? \"\uB8EC\uC758 \uAD11\uCC44\uAC00 \uB208\uBD80\uC2DC\uAD70.\" : {itemType
      == material ? \"\uC7AC\uB8CC\uC758 \uBE5B\uAE54\uC774 \uBC94\uC0C1\uCE58 \uC54A\uAD70.\"
      : \"\uB208\uC774 \uBC88\uCA4D \uB728\uC774\uB294 \uBB3C\uAC74\uC774\uAD70.\"}}}}
      {price}\uACE8\uB4DC\uB97C \uB0B4\uC9C0. \uAC12\uC740 \uC2E0\uACBD \uC4F0\uC9C0
      \uB9D0\uAC8C."
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uB0B4 \uB208\uC5D0 \uB4E4\uC5C8\uB124. {price}\uACE8\uB4DC\uBA74
      \uCDA9\uBD84\uD558\uACA0\uC9C0?"
  - speakerId: 0
    text: "\uAC00\uACA9\uD45C\uB294 \uD544\uC694 \uC5C6\uB124. {price}\uACE8\uB4DC\uB97C
      \uBC1B\uACE0 \uBB3C\uAC74\uC744 \uB118\uAE30\uAC8C."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC804\uBD80 \uB0B4 \uC18C\uC7A5\uD488\uC73C\uB85C
      \uC0BC\uACA0\uB124. \uAC1C\uB2F9 {unitPrice}\uACE8\uB4DC, \uD569\uCCD0 {price}\uACE8\uB4DC\uB97C
      \uB0B4\uC9C0.\" : \"\uB2E8 \uD558\uB098\uBFD0\uC774\uB77C\uB2C8 \uB354 \uD0D0\uB098\uB294\uAD70.
      {price}\uACE8\uB4DC\uB97C \uB0B4\uC9C0.\"}"
  - speakerId: 0
    text: "{groupName}\uC758 {npcName}\uC77C\uC138. {itemName}\uC5D0 {price}\uACE8\uB4DC\uB97C
      \uB0B4\uC9C0."
  - speakerId: 0
    text: "{price > baseValue ? \"{baseValue}\uACE8\uB4DC\uB77C\uACE0? \uADF8 \uAC12\uC73C\uB860
      \uC774 \uBB3C\uAC74\uC5D0 \uC2E4\uB840\uC77C\uC138. {price}\uACE8\uB4DC\uB97C
      \uB0B4\uC9C0.\" : \"{itemName}(\uC740/\uB294) \uAC12\uC5B4\uCE58\uAC00 \uC788\uC5B4
      \uBCF4\uC774\uB294\uAD70. {price}\uACE8\uB4DC\uB97C \uB0B4\uC9C0.\"}"
  - speakerId: 0
    text: "{itemElement == flame ? \"\uD0C0\uC624\uB974\uB294 \uBD88\uAF43\uC758
      \uC790\uD0DC\uAC00 \uC77C\uD488\uC774\uAD70.\" : {itemElement == cold ? \"\uC11C\uB9AC\uAC00
      \uB9FA\uD78C \uB4EF\uD55C \uBE5B\uAE54\uC774 \uACF1\uAD70.\" : {itemElement
      == lightning ? \"\uBC88\uB729\uC774\uB294 \uB1CC\uAD11\uC774 \uB208\uC744 \uC0AC\uB85C\uC7A1\uB294\uAD70.\"
      : {itemElement == wind ? \"\uBC14\uB78C\uACB0\uC774 \uAC10\uB3C4\uB294 \uBAA8\uC2B5\uC774
      \uC6B0\uC544\uD558\uAD70.\" : {itemElement == earth ? \"\uB300\uC9C0\uC758
      \uBB35\uC9C1\uD55C \uD488\uACA9\uC774 \uB290\uAEF4\uC9C0\uB294\uAD70.\" : {itemElement
      == holy ? \"\uC131\uC2A4\uB7EC\uC6B4 \uAD11\uD718\uAC00 \uC740\uC740\uD558\uAD70.\"
      : {itemElement == dark ? \"\uC5B4\uB460\uC774 \uAE43\uB4E0 \uC790\uD0DC\uAC00
      \uB9E4\uD639\uC801\uC774\uAD70.\" : \"\uC790\uD0DC\uAC00 \uB0A8\uB2E4\uB974\uAD70.\"}}}}}}}
      {price}\uACE8\uB4DC\uBA74 \uB0B4 \uC18C\uC7A5\uD488\uC73C\uB85C \uB4E4\uC77C
      \uB9CC\uD558\uC9C0."
  - speakerId: 0
    text: "\uC774\uB7F0 \uBB3C\uAC74\uC740 \uC544\uBB34\uC5D0\uAC8C\uB098 \uB118\uAE30\uC9C0
      \uB9D0\uAC8C. {price}\uACE8\uB4DC, \uB098\uC5D0\uAC8C \uB118\uAE30\uAC8C."
  - speakerId: 0
    text: "{itemType == material ? \"\uC774\uB9CC\uD55C \uC7AC\uB8CC\uB294 \uC218\uC9D1\uD488\uC73C\uB85C
      \uB458 \uAC00\uCE58\uAC00 \uC788\uAD70.\" : {itemType == rune ? \"\uC774\uB7F0
      \uB8EC\uC740 \uC9C4\uC5F4\uD574 \uB458 \uB9CC\uD558\uAD70.\" : \"\uC774\uB9CC\uD55C
      \uBB3C\uAC74\uC740 \uC9C4\uC5F4\uD574 \uB458 \uB9CC\uD558\uAD70.\"}} {price}\uACE8\uB4DC,
      \uC5B4\uB5A4\uAC00."
  - speakerId: 0
    text: "\uAE34 \uB9D0\uC740 \uC2EB\uB124. {price}\uACE8\uB4DC, \uC9C0\uAE08 \uB2F5\uD558\uAC8C."
  _negotiation:
  - speakerId: 0
    text: "\uADF8 \uC815\uB3C4\uBA74 \uB418\uACA0\uB098. {price}\uACE8\uB4DC\uB85C
      \uC62C\uB824 \uC8FC\uC9C0."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC? \uD760, \uB098\uC058\uC9C0 \uC54A\uAD70. {prevPrice}\uACE8\uB4DC\uC5D0\uC11C
      {price}\uACE8\uB4DC\uB85C \uC62C\uB9AC\uACA0\uB124."
  - speakerId: 0
    text: "{bargainCount >= 2 ? \"\uC2E4\uB791\uC774\uAC00 \uAE38\uC5B4\uC9C0\uB294\uAD70.
      \uBC88\uAC70\uB85C\uC6B0\uB2C8 {price}\uACE8\uB4DC\uB85C \uB05D\uB0B4\uC138.\"
      : \"{price}\uACE8\uB4DC\uB85C \uC62C\uB9AC\uC9C0. \uC774 \uC815\uB3C4\uBA74
      \uD761\uC871\uD558\uACA0\uC9C0?\"}"
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"{askPrice}\uACE8\uB4DC\uB77C\uB2C8, \uBC30\uC9F1
      \uD55C\uBC88 \uC88B\uAD70. \uB9C8\uC74C\uC5D0 \uB4DC\uB124. {price}\uACE8\uB4DC\uAE4C\uC9C0
      \uC4F0\uC9C0.\" : \"{askPrice}\uACE8\uB4DC\uCBE4\uC774\uC57C \uD47C\uB3C8\uC774\uC9C0.
      {price}\uACE8\uB4DC\uB85C \uD558\uC138.\"}"
  - speakerId: 0
    text: "{priceGap}\uACE8\uB4DC \uCC28\uC774\uB85C \uC2E4\uB791\uC774\uD560 \uC0DD\uAC01\uC740
      \uC5C6\uB124. {price}\uACE8\uB4DC\uB85C \uC62C\uB9AC\uC9C0."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uB97C \uB4E4\uC774\uB294 \uAC12\uC774\uB2C8
      \uB109\uB109\uD788 \uCCD0\uC8FC\uC9C0. {price}\uACE8\uB4DC\uC77C\uC138.\" :
      \"\uB2E8 \uD558\uB098\uB97C \uC704\uD55C \uAC12\uC774\uB2C8 \uB109\uB109\uD788
      \uCCD0\uC8FC\uC9C0. {price}\uACE8\uB4DC\uC77C\uC138.\"}"
  - speakerId: 0
    text: "{itemElement != none ? \"\uAE43\uB4E0 \uAE30\uC6B4\uC774 \uB9C8\uC74C\uC5D0
      \uB4DC\uB294\uAD70. \uAC12\uC740 \uB354 \uCCD0\uC8FC\uC9C0. {price}\uACE8\uB4DC\uC77C\uC138.\"
      : \"{itemName}(\uC774/\uAC00) \uB9C8\uC74C\uC5D0 \uB4DC\uB294\uAD70. \uAC12\uC740
      \uB354 \uCCD0\uC8FC\uC9C0. {price}\uACE8\uB4DC\uC77C\uC138.\"}"
  - speakerId: 0
    text: "{price > baseValue ? \"{baseValue}\uACE8\uB4DC\uB85C\uB294 \uC774 \uBB3C\uAC74\uC5D0
      \uC5B4\uC6B8\uB9AC\uC9C0 \uC54A\uC9C0. {price}\uACE8\uB4DC\uB85C \uD558\uC138.\"
      : \"{price}\uACE8\uB4DC\uB97C \uCCD0\uC8FC\uC9C0. \uC5B4\uC11C \uC815\uD558\uAC8C.\"}"
  - speakerId: 0
    text: "\uB09C \uD55C\uBC88 \uB9C8\uC74C\uBA39\uC73C\uBA74 \uAC12\uC744
      \uB530\uC9C0\uC9C0 \uC54A\uB124. {price}\uACE8\uB4DC\uB97C \uBC1B\uAC8C."
  - speakerId: 0
    text: "\uC2DC\uAC04 \uB04C\uC9C0 \uB9D0\uAC8C. {price}\uACE8\uB4DC\uBA74 \uCDA9\uBD84\uD558\uC9C0
      \uC54A\uB098."
  _finalOffer:
  - speakerId: 0
    text: "\uC774\uAC8C \uB9C8\uC9C0\uB9C9\uC77C\uC138. {price}\uACE8\uB4DC, \uB354\uB294
      \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACA0\uB124."
  - speakerId: 0
    text: "{firstPrice}\uACE8\uB4DC\uC5D0\uC11C {price}\uACE8\uB4DC\uAE4C\uC9C0 \uC62C\uB838\uB124.
      \uC774\uCBE4\uC5D0\uC11C \uADF8\uB9CC\uD558\uAC8C."
  - speakerId: 0
    text: "{price}\uACE8\uB4DC, \uC9C0\uCCB4\uB294 \uC9C8\uC0C9\uC77C\uC138. \uC9C0\uAE08
      \uB2F5\uD558\uAC8C."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC804\uBD80\uC5D0 {price}\uACE8\uB4DC\uB97C
      \uB0B4\uC9C0. \uB354 \uAE30\uB2E4\uB9AC\uAC8C \uD558\uC9C0 \uB9D0\uAC8C.\"
      : \"\uC774 \uD558\uB098\uC5D0 {price}\uACE8\uB4DC\uB97C \uB0B4\uC9C0. \uB354
      \uAE30\uB2E4\uB9AC\uAC8C \uD558\uC9C0 \uB9D0\uAC8C.\"}"
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uACFC\uD558\uB124. {price}\uACE8\uB4DC,
      \uC774\uAC83\uC73C\uB85C \uB05D\uC77C\uC138."
  - speakerId: 0
    text: "\uB0B4 \uB9C8\uC9C0\uB9C9 \uC81C\uC548\uC77C\uC138. {price}\uACE8\uB4DC.
      \uAC70\uC808\uD558\uBA74 \uD6C4\uD68C\uD560 \uAC78\uC138."
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC\uC5D0 \uC774 \uC774\uC0C1\uC740
      \uB0B4\uC9C0 \uC54A\uACA0\uB124.\" : {itemType == rune ? \"\uB8EC\uC5D0 \uC774
      \uC774\uC0C1\uC740 \uB0B4\uC9C0 \uC54A\uACA0\uB124.\" : \"\uC774 \uBB3C\uAC74\uC5D0
      \uC774 \uC774\uC0C1\uC740 \uB0B4\uC9C0 \uC54A\uACA0\uB124.\"}} {price}\uACE8\uB4DC\uC77C\uC138."
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"{priceGap}\uACE8\uB4DC\uB098 \uBC8C\uC5B4\uC84C\uAD70.
      \uC544\uBB34\uB9AC \uB098\uB77C\uB3C4 \uADF8\uAC74 \uACFC\uD558\uB124. {price}\uACE8\uB4DC\uAC00
      \uB05D\uC77C\uC138.\" : \"{price}\uACE8\uB4DC\uB85C \uC815\uD558\uC138. \uC774
      \uC815\uB3C4\uBA74 \uCDA9\uBD84\uD788 \uD6C4\uD558\uC9C0 \uC54A\uB098.\"}"
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uD0D0\uB098\uC9C0\uB9CC \uAE30\uB2E4\uB9BC\uC5D0\uB3C4
      \uD55C\uACC4\uAC00 \uC788\uB124. {price}\uACE8\uB4DC\uC77C\uC138."
  - speakerId: 0
    text: "{price}\uACE8\uB4DC, \uBC1B\uC744 \uD150\uAC00 \uB9D0 \uD150\uAC00. \uC624\uB798
      \uAE30\uB2E4\uB9AC\uAC8C \uD558\uC9C0 \uB9D0\uAC8C."
  _acception:
  - speakerId: 0
    text: "\uC88B\uB124. \uADF8 \uAC12\uC5D0 \uAC70\uB798\uD558\uC9C0."
  - speakerId: 0
    text: "{itemType == sword ? \"\uC774 \uAC80\uC740 \uB0B4 \uC9C4\uC5F4\uC7A5\uC5D0\uC11C
      \uAC00\uC7A5 \uBE5B\uB098\uACA0\uAD70.\" : {itemType == bow ? \"\uC774 \uD65C\uC740
      \uB0B4 \uC9C4\uC5F4\uC7A5\uC5D0\uC11C \uAC00\uC7A5 \uBE5B\uB098\uACA0\uAD70.\"
      : \"\uC774 \uBB3C\uAC74\uC740 \uB0B4 \uC9C4\uC5F4\uC7A5\uC5D0\uC11C \uAC00\uC7A5
      \uBE5B\uB098\uACA0\uAD70.\"}}"
  - speakerId: 0
    text: "{price}\uACE8\uB4DC, \uBC1B\uAC8C. \uC138\uC5B4 \uBCFC \uD544\uC694\uB3C4
      \uC5C6\uB124."
  - speakerId: 0
    text: "{itemName}(\uC744/\uB97C) \uC190\uC5D0 \uB123\uC5C8\uC73C\uB2C8 \uC624\uB298\uC740
      \uAE30\uBD84\uC774 \uC88B\uAD70."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC804\uBD80 \uB0B4 \uC18C\uC7A5\uD488\uC73C\uB85C
      \uC62C\uB824 \uB450\uAC8C.\" : \"\uB0B4 \uC18C\uC7A5\uD488\uC73C\uB85C \uC62C\uB824
      \uB450\uAC8C.\"} \uC218\uACE0\uD588\uB124."
  - speakerId: 0
    text: "{itemElement == flame ? \"\uBD88\uAF43\uC758 \uC790\uD0DC\uB97C \uACC1\uC5D0
      \uB450\uAC8C \uB418\uC5C8\uAD70.\" : {itemElement == cold ? \"\uC11C\uB9AC\uC758
      \uBE5B\uC744 \uACC1\uC5D0 \uB450\uAC8C \uB418\uC5C8\uAD70.\" : {itemElement
      == holy ? \"\uC131\uC2A4\uB7EC\uC6B4 \uAD11\uD718\uB97C \uACC1\uC5D0 \uB450\uAC8C
      \uB418\uC5C8\uAD70.\" : {itemElement == dark ? \"\uC5B4\uB460\uC758 \uB9E4\uD639\uC744
      \uACC1\uC5D0 \uB450\uAC8C \uB418\uC5C8\uAD70.\" : \"\uC774\uB7F0 \uBB3C\uAC74\uC744
      \uACC1\uC5D0 \uB450\uAC8C \uB418\uB2E4\uB2C8.\"}}}} \uD761\uC871\uD558\uAD70."
  - speakerId: 0
    text: "{groupName}\uC758 \uBC97\uB4E4\uC5D0\uAC8C \uC790\uB791\uD574\uC57C\uACA0\uAD70.
      \uC798 \uBC1B\uACA0\uB124."
  - speakerId: 0
    text: "\uB09C \uB9C8\uC74C\uC5D0 \uB4E0 \uBB3C\uAC74\uC5D0
      \uAC12\uC744 \uC544\uB07C\uC9C0 \uC54A\uB124. \uAE30\uC5B5\uD574 \uB450\uAC8C."
  - speakerId: 0
    text: "{price > baseValue ? \"{baseValue}\uACE8\uB4DC \uB530\uC704\uB85C\uB294
      \uC774 \uBB3C\uAC74\uC774 \uC544\uAE5D\uC9C0. \uD6C4\uD558\uAC8C \uCCD0\uC11C
      \uB2E4\uD589\uC774\uAD70.\" : \"\uD569\uB9AC\uC801\uC778 \uAC12\uC774\uAD70.
      \uB9C8\uC74C\uC5D0 \uB4DC\uB124.\"}"
  - speakerId: 0
    text: "\uAE54\uB054\uD574\uC11C \uC88B\uAD70. \uC774\uB798\uC57C \uAC70\uB798\uC9C0."
  _rejection:
  - speakerId: 0
    text: "\uD765\uC774 \uAE68\uC84C\uAD70. \uC774\uB9CC \uAC00\uACA0\uB124."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uAC00 \uBB38\uC81C\uAC00 \uC544\uB2C8\uB124. \uC9C0\uCCB4\uAC00
      \uB9C8\uC74C\uC5D0 \uB4E4\uC9C0 \uC54A\uC744 \uBFD0\uC774\uC9C0."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C\uB098 \uB4E4\uC77C \uC0DD\uAC01\uC774\uC5C8\uB294\uB370,
      \uAE30\uBD84\uC774 \uC0C1\uD588\uAD70.\" : \"\uB9C8\uC74C\uC5D0 \uB4E4\uC5C8\uB294\uB370,
      \uAE30\uBD84\uC774 \uC0C1\uD588\uAD70.\"} \uC774\uB9CC \uAC00\uB124."
  - speakerId: 0
    text: "{itemName}(\uC774/\uAC00) \uC544\uAE5D\uC9C0\uB9CC \uB354 \uAE30\uB2E4\uB9B4
      \uC218\uB294 \uC5C6\uB124."
  - speakerId: 0
    text: "{itemElement != none ? \"\uADF8 \uAE30\uC6B4\uC774 \uC544\uAE5D\uAE34
      \uD558\uAD70. \uADF8\uB798\uB3C4 \uC774\uB9CC \uAC00\uB124.\" : \"\uC544\uAE5D\uAE34
      \uD558\uAD70. \uADF8\uB798\uB3C4 \uC774\uB9CC \uAC00\uB124.\"}"
  - speakerId: 0
    text: "{groupName}(\uC740/\uB294) \uC624\uB798 \uAE30\uB2E4\uB9AC\uB294 \uBC95\uC774
      \uC5C6\uB124. \uC774\uB9CC \uAC00\uC9C0."
  - speakerId: 0
    text: "\uB0A0 \uAE30\uB2E4\uB9AC\uAC8C \uD55C \uB300\uAC00\uC77C\uC138.
      \uB2E4\uB978 \uBB3C\uAC74\uC744 \uCC3E\uC544\uBCF4\uC9C0."
  - speakerId: 0
    text: "{itemType == sword ? \"\uC774\uB9CC\uD55C \uAC80\uC740 \uB610 \uB098\uC624\uACA0\uC9C0.
      \uC774\uB9CC \uAC00\uACA0\uB124.\" : {itemType == bow ? \"\uC774\uB9CC\uD55C
      \uD65C\uC740 \uB610 \uB098\uC624\uACA0\uC9C0. \uC774\uB9CC \uAC00\uACA0\uB124.\"
      : \"\uC774\uB9CC\uD55C \uBB3C\uAC74\uC740 \uB610 \uB098\uC624\uACA0\uC9C0.
      \uC774\uB9CC \uAC00\uACA0\uB124.\"}}"
  - speakerId: 0
    text: "{askRatio >= 1.5 ? \"\uB0B4\uAC00 \uC544\uBB34\uB9AC \uB108\uADF8\uB7EC\uC6CC\uB3C4
      \uADF8 \uAC12\uC740 \uACFC\uD558\uAD70. \uC774\uB9CC \uAC00\uACA0\uB124.\"
      : \"\uB354\uB294 \uBABB \uAE30\uB2E4\uB9AC\uACA0\uAD70. \uC774\uB9CC \uAC00\uACA0\uB124.\"}"
  - speakerId: 0
    text: "\uAE30\uBD84\uC774 \uC0C1\uD588\uB124. \uB2E4\uC2DC \uBCFC \uC77C\uC740
      \uC5C6\uAE38 \uBC14\uB77C\uC9C0."
