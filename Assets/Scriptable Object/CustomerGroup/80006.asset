  _customerSprites: []
  _firstOffer:
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC \uBC18\uC785 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uC7AC\uACE0 \uB300\uC7A5\uC5D0 \uBE48\uCE78\uC774 \uD558\uB098 \uB0A8\uC544
      \uC788\uC5C8\uB294\uB370 \uB9C8\uCE68 \uB9DE\uC2B5\uB2C8\uB2E4.\" : {itemType
      == rune ? \"\uB8EC \uBC18\uC785 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4. \uC9C0\uB09C
      \uBD84\uAE30 \uAC10\uC0AC\uC5D0\uC11C \uB8EC \uC7AC\uACE0 \uBD80\uC871\uC744
      \uC9C0\uC801\uBC1B\uC740 \uD130\uB77C \uBC18\uAC11\uAD70\uC694.\" : {itemType
      == consumable ? \"\uC18C\uBAA8\uD488 \uBC18\uC785 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uC774\uBC88 \uC8FC \uC18C\uC9C4\uB7C9\uC774 \uB9CE\uC544 \uAE30\uC900\uC120
      \uC544\uB798\uC600\uC2B5\uB2C8\uB2E4.\" : \"\uBC18\uC785 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uC7AC\uACE0 \uB300\uC7A5\uC5D0 \uBE48\uCE78\uC774 \uD558\uB098 \uB0A8\uC544
      \uC788\uC5C8\uC2B5\uB2C8\uB2E4.\"}}} \uAE38\uB4DC \uADDC\uC815 \uB9E4\uC785\uAC00\uC5D0
      \uB9DE\uCDB0 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC77C\uAD04 \uC811\uC218\uD569\uB2C8\uB2E4.
      \uC218\uB7C9\uC774 \uB9CE\uC544\uB3C4 \uB2E8\uAC00 \uAE30\uC900\uC740 \uAC19\uC2B5\uB2C8\uB2E4.
      \uCD1D {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : \"1\uAC1C\uB4E0 100\uAC1C\uB4E0
      \uC801\uC6A9 \uAE30\uC900\uC740 \uAC19\uC2B5\uB2C8\uB2E4. \uAE38\uB4DC \uADDC\uC815
      \uB9E4\uC785\uAC00\uB85C {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{itemName}(\uC744/\uB97C) \uC811\uC218\uD569\uB2C8\uB2E4. {price >= baseValue
      ? \"\uADDC\uC815 \uB9E4\uC785\uAC00 \uC0C1\uD55C \uC548\uC5D0\uC11C {price}\uACE8\uB4DC\uB85C
      \uC0B0\uC815\uD588\uC2B5\uB2C8\uB2E4.\" : \"\uADDC\uC815 \uB9E4\uC785\uAC00
      \uC0B0\uC815\uD45C\uB300\uB85C {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{groupName}\uC758 {npcName}\uC785\uB2C8\uB2E4. {itemName}(\uC744/\uB97C)
      \uADDC\uC815 \uB9E4\uC785\uAC00 {price}\uACE8\uB4DC\uB85C \uC811\uC218\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == consumable ? \"\uC18C\uBAA8\uD488\uC740 \uC18C\uC9C4\uC774
      \uBE68\uB77C\uC11C \uC7AC\uACE0 \uAE30\uC900\uC120\uC744 \uB9E4\uC8FC \uD655\uC778\uD569\uB2C8\uB2E4.
      \uC774\uBC88 \uAC74\uC740 \uAE30\uC900\uC120 \uC544\uB798\uB77C \uBC18\uAC11\uC2B5\uB2C8\uB2E4.\"
      : {itemType == material ? \"\uC7AC\uB8CC\uB294 \uB0A9\uD488 \uC77C\uC815\uC774
      \uC5B4\uAE0B\uB098\uAE30 \uC26C\uC6B4 \uBD84\uB958\uC785\uB2C8\uB2E4. \uC774\uBC88
      \uAC74\uC774 \uC77C\uC815 \uACF5\uBC31\uC744 \uBA54\uC6CC \uC90D\uB2C8\uB2E4.\"
      : \"\uC7AC\uACE0 \uAE30\uC900\uC120 \uC544\uB798\uC600\uB358 \uD56D\uBAA9\uC785\uB2C8\uB2E4.
      \uC774\uBC88 \uAC74\uC73C\uB85C \uBA54\uC6CC\uC9D1\uB2C8\uB2E4.\"}} \uADDC\uC815
      \uB9E4\uC785\uAC00\uB294 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "\uAC10\uC815\uAC00 \uD611\uC758\uB294 \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uADDC\uC815\uD45C\uC5D0 \uC801\uD78C \uC22B\uC790\uAC00 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "\uADDC\uC815 \uBC16\uC758 \uAE08\uC561\uC740 \uC81C \uAD8C\uD55C\uC73C\uB85C
      \uC9C0\uAE09\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC, \uADDC\uC815
      \uC548\uC758 \uAE08\uC561\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC\uB294 \uC218\uB7C9\uACFC \uC0C1\uD0DC\uB9CC
      \uD655\uC778\uD558\uBA74 \uB429\uB2C8\uB2E4. \uADDC\uC815\uC0C1 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"
      : {itemType == rune ? \"\uB8EC\uC740 \uAE30\uC6B4 \uC0C1\uD0DC\uB9CC \uD655\uC778\uD558\uBA74
      \uB429\uB2C8\uB2E4. \uC774\uC0C1 \uC5C6\uC2B5\uB2C8\uB2E4. \uADDC\uC815\uC0C1
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : {itemType == consumable ? \"\uC18C\uBAA8\uD488\uC740
      \uC218\uB7C9\uACFC \uD3EC\uC7A5 \uC0C1\uD0DC\uB9CC \uD655\uC778\uD558\uBA74
      \uB429\uB2C8\uB2E4. \uC774\uC0C1 \uC5C6\uC2B5\uB2C8\uB2E4. \uADDC\uC815\uC0C1
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : \"\uC0C1\uD0DC \uD655\uC778\uC740
      \uB05D\uB0AC\uC2B5\uB2C8\uB2E4. \uADDC\uC815\uC0C1 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"}}}"
  - speakerId: 0
    text: "\uC624\uB298 \uC811\uC218 \uB9C8\uAC10 \uC804\uC5D0 \uCC98\uB9AC\uD574\uC57C
      \uD569\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB85C \uBC14\uB85C \uC9C4\uD589\uD558\uC2DC\uC8E0."
  - speakerId: 0
    text: "\uC6A9\uBCD1 \uAD00\uB9AC\uC778 \uCABD\uC5D0\uC11C \uC62C\uB77C\uC628
      \uC694\uCCAD \uBB3C\uB7C9\uACFC \uB300\uC870\uD588\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB85C
      \uC9C4\uD589\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  _negotiation:
  - speakerId: 0
    text: "{prevPrice}\uACE8\uB4DC\uC5D0\uC11C {price}\uACE8\uB4DC\uB85C \uC815\uC815\uD569\uB2C8\uB2E4.
      \uC815\uC815 \uC0AC\uC720\uB294 \uC11C\uC2DD\uC5D0 \uC801\uC5B4 \uB450\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uADDC\uC815 \uBC94\uC704\uB97C \uBC97\uC5B4\uB0A9\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uAE4C\uC9C0\uB9CC \uCC98\uB9AC \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{bargainCount >= 2 ? \"\uAC19\uC740 \uD611\uC758\uAC00 \uBC18\uBCF5\uB418\uACE0
      \uC788\uC2B5\uB2C8\uB2E4. \uADDC\uC815\uC740 \uADF8\uB300\uB85C\uC774\uACE0
      {price}\uACE8\uB4DC\uAC00 \uC870\uC815 \uD55C\uB3C4\uC785\uB2C8\uB2E4.\" :
      \"\uC870\uC815 \uAC00\uB2A5\uD55C \uBC94\uC704\uC5D0\uC11C {price}\uACE8\uB4DC\uB85C
      \uC62C\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{askRatio >= 1.3 ? \"{askPrice}\uACE8\uB4DC\uB294 \uBC18\uB824 \uB300\uC0C1\uC785\uB2C8\uB2E4.
      \uC11C\uC2DD\uC5D0 \uC801\uC744 \uC218 \uC5C6\uB294 \uC22B\uC790\uC785\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uB85C \uD558\uACA0\uC2B5\uB2C8\uB2E4.\" : \"{askPrice}\uACE8\uB4DC\uB294
      \uC7AC\uB7C9 \uBC94\uC704\uB97C \uC870\uAE08 \uB118\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC\uB85C
      \uB9DE\uCD94\uACA0\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{priceGap}\uACE8\uB4DC \uCC28\uC774\uB294 \uADDC\uC815\uC0C1 \uBCF4\uC804\uC774
      \uC548 \uB429\uB2C8\uB2E4. \uC81C \uC7AC\uB7C9\uC73C\uB85C\uB294 {price}\uACE8\uB4DC\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC77C\uAD04 \uAC74\uC774\uB77C \uAC1C\uB2F9
      {unitPrice}\uACE8\uB4DC\uB85C \uACC4\uC0B0\uD588\uC2B5\uB2C8\uB2E4. \uCD1D
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : \"1\uAC1C \uAC74\uC774\uC5B4\uB3C4
      \uACC4\uC0B0 \uBC29\uC2DD\uC740 \uAC19\uC2B5\uB2C8\uB2E4. {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{price >= baseValue ? \"\uC774\uBBF8 \uADDC\uC815 \uB9E4\uC785\uAC00 \uC774\uC0C1\uC785\uB2C8\uB2E4.
      \uC774 \uC774\uC0C1\uC740 \uAC10\uC0AC\uC5D0 \uAC78\uB9BD\uB2C8\uB2E4. {price}\uACE8\uB4DC\uAC00
      \uD55C\uB3C4\uC785\uB2C8\uB2E4.\" : \"\uADDC\uC815 \uBC94\uC704 \uC548\uC5D0\uC11C
      {price}\uACE8\uB4DC\uAE4C\uC9C0 \uC62C\uB838\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{itemType == consumable ? \"\uC18C\uBAA8\uD488\uC740 \uD68C\uC804\uC774
      \uBE60\uB978 \uBD84\uB958\uB77C \uADDC\uC815\uC0C1 \uAC00\uC0B0 \uD56D\uBAA9\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4. \uB2E8\uAC00\uD45C \uAE30\uC900\uC73C\uB85C {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"
      : \"\uBD84\uB958\uBCC4 \uB2E8\uAC00\uD45C \uAE30\uC900\uC73C\uB85C {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC\uB294 \uC2DC\uC138 \uBCC0\uB3D9\uC774
      \uD070 \uBD84\uB958\uB77C \uC6D4\uB9D0 \uC815\uC0B0 \uAE30\uC900\uC73C\uB85C
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : {itemType == rune ? \"\uB8EC\uC740
      \uACE0\uAC00 \uD56D\uBAA9\uC774\uB77C \uACB0\uC7AC\uC120\uC774 \uAE38\uC5B4\uC9D1\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uAC00 \uD604\uC2E4\uC801\uC778 \uC120\uC785\uB2C8\uB2E4.\"
      : {itemType == consumable ? \"\uC18C\uBAA8\uD488\uC740 \uB300\uB7C9 \uCC98\uB9AC
      \uAC74\uC774 \uB9CE\uC544 \uB2E8\uAC00\uB97C \uACE0\uC815\uD574 \uB461\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : \"\uBD84\uB958\uC0C1 \uCC98\uB9AC
      \uAC00\uB2A5\uD55C \uC120\uC740 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\"}}}"
  - speakerId: 0
    text: "{npcName}(\uC740/\uB294) \uADDC\uC815\uC744 \uBC14\uAFC0 \uAD8C\uD55C\uC774
      \uC5C6\uC2B5\uB2C8\uB2E4. \uBC14\uAFD4 \uB4DC\uB9B4 \uC218 \uC788\uB294 \uAC74
      {price}\uACE8\uB4DC\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
  _finalOffer:
  - speakerId: 0
    text: "\uC774 \uC22B\uC790\uAC00 \uCD5C\uC885\uC785\uB2C8\uB2E4. {price}\uACE8\uB4DC,
      \uC774\uD6C4 \uD611\uC758\uB294 \uC811\uC218\uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{firstPrice}\uACE8\uB4DC\uC5D0\uC11C {price}\uACE8\uB4DC\uB85C \uC815\uC815\uD588\uC2B5\uB2C8\uB2E4.
      \uC815\uC815\uC740 \uC5EC\uAE30\uAE4C\uC9C0\uC785\uB2C8\uB2E4."
  - speakerId: 0
    text: "{price}\uACE8\uB4DC\uAC00 \uC81C \uACB0\uC7AC \uAC00\uB2A5\uD55C \uC0C1\uD55C\uC785\uB2C8\uB2E4.
      \uC774 \uC704\uB294 \uC0C1\uBD80 \uACB0\uC7AC\uAC00 \uD544\uC694\uD55C\uB370,
      \uC62C\uB9B4 \uC0DD\uAC01\uC740 \uC5C6\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC77C\uAD04 \uCC98\uB9AC\uC5D0 {price}\uACE8\uB4DC\uAC00
      \uC0C1\uD55C\uC785\uB2C8\uB2E4.\" : \"1\uAC1C \uAC74\uC5D0 {price}\uACE8\uB4DC\uAC00
      \uC0C1\uD55C\uC785\uB2C8\uB2E4.\"} \uC218\uB77D \uC5EC\uBD80\uB9CC \uB9D0\uC500\uD574
      \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uC11C\uC2DD\uC5D0 \uC801\uC744 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uB85C \uCC98\uB9AC\uD560\uC9C0 \uB2F5\uD574 \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{npcName}\uC758 \uCD5C\uC885 \uC548\uB0B4\uC785\uB2C8\uB2E4. {price}\uACE8\uB4DC,
      \uC218\uB77D \uC5EC\uBD80\uB9CC \uB9D0\uC500\uD574 \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC \uBD84\uB958\uC758 \uC0C1\uD55C\uC740
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4. \uC774 \uC774\uC0C1\uC740 \uADDC\uC815\uC5D0
      \uC5C6\uC2B5\uB2C8\uB2E4.\" : {itemType == rune ? \"\uB8EC \uBD84\uB958\uC758
      \uC0C1\uD55C\uC740 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4. \uC774 \uC774\uC0C1\uC740
      \uADDC\uC815\uC5D0 \uC5C6\uC2B5\uB2C8\uB2E4.\" : {itemType == consumable ?
      \"\uC18C\uBAA8\uD488 \uBD84\uB958\uC758 \uC0C1\uD55C\uC740 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.
      \uC774 \uC774\uC0C1\uC740 \uADDC\uC815\uC5D0 \uC5C6\uC2B5\uB2C8\uB2E4.\" :
      \"\uD574\uB2F9 \uBD84\uB958\uC758 \uC0C1\uD55C\uC740 {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.
      \uC774 \uC774\uC0C1\uC740 \uADDC\uC815\uC5D0 \uC5C6\uC2B5\uB2C8\uB2E4.\"}}}"
  - speakerId: 0
    text: "{askRatio >= 1.3 ? \"{priceGap}\uACE8\uB4DC\uB098 \uBC8C\uC5B4\uC9C0\uBA74
      \uC811\uC218 \uC790\uCCB4\uAC00 \uC548 \uB429\uB2C8\uB2E4. {price}\uACE8\uB4DC\uAC00
      \uCD5C\uC885\uC785\uB2C8\uB2E4.\" : \"{price}\uACE8\uB4DC\uB85C \uC815\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774 \uC815\uB3C4 \uCC28\uC774\uB294 \uADDC\uC815 \uD5C8\uC6A9 \uC624\uCC28\uC785\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "\uB2E4\uC74C \uC811\uC218 \uAC74\uC774 \uBC00\uB824 \uC788\uC2B5\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uB85C \uACB0\uC815\uD574 \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{price >= baseValue ? \"\uADDC\uC815 \uB9E4\uC785\uAC00 \uC774\uC0C1\uC73C\uB85C
      \uC774\uBBF8 \uCC98\uB9AC\uD588\uC2B5\uB2C8\uB2E4. \uB354\uB294 \uBABB \uC62C\uB9BD\uB2C8\uB2E4.
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4.\" : \"\uADDC\uC815 \uBC94\uC704 \uCD5C\uB300\uCE58\uB85C
      {price}\uACE8\uB4DC\uC785\uB2C8\uB2E4. \uC774 \uC774\uC0C1\uC740 \uBD88\uAC00\uD569\uB2C8\uB2E4.\"}"
  _acception:
  - speakerId: 0
    text: "\uC811\uC218 \uC644\uB8CC\uC785\uB2C8\uB2E4. \uC11C\uC2DD\uC740 \uC81C\uAC00
      \uC791\uC131\uD558\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC \uC785\uACE0 \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC7AC\uACE0 \uB300\uC7A5\uC758 \uBE48\uCE78\uC774 \uCC44\uC6CC\uC84C\uC2B5\uB2C8\uB2E4.\"
      : {itemType == rune ? \"\uB8EC \uC785\uACE0 \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uAC10\uC0AC\uC5D0\uC11C \uC9C0\uC801\uBC1B\uC740 \uBD80\uBD84\uC774 \uBA54\uC6CC\uC84C\uC2B5\uB2C8\uB2E4.\"
      : {itemType == consumable ? \"\uC18C\uBAA8\uD488 \uC785\uACE0 \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774\uBC88 \uC8FC \uAE30\uC900\uC120\uC740 \uB9DE\uCDC4\uC2B5\uB2C8\uB2E4.\"
      : \"\uC785\uACE0 \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4. \uC7AC\uACE0 \uB300\uC7A5\uC5D0
      \uBC18\uC601\uD558\uACA0\uC2B5\uB2C8\uB2E4.\"}}}"
  - speakerId: 0
    text: "{price}\uACE8\uB4DC, \uC9C0\uAE09 \uC11C\uC2DD \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4.
      \uC218\uB839 \uD655\uC778\uB9CC \uD574 \uC8FC\uC2ED\uC2DC\uC624."
  - speakerId: 0
    text: "{itemName}(\uC744/\uB97C) \uC785\uACE0\uD558\uACE0 \uC7AC\uACE0 \uB300\uC7A5\uC5D0
      \uAE30\uC7AC\uD588\uC2B5\uB2C8\uB2E4. \uAC70\uB798 \uC99D\uBE59\uC740 \uBCF4\uAD00\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC804\uBD80 \uC785\uACE0 \uCC98\uB9AC\uD569\uB2C8\uB2E4.
      \uC218\uB7C9 \uB300\uC870\uB3C4 \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\" : \"1\uAC1C
      \uC785\uACE0 \uCC98\uB9AC\uD569\uB2C8\uB2E4. \uC218\uB7C9 \uB300\uC870\uB3C4
      \uB05D\uB0AC\uC2B5\uB2C8\uB2E4.\"} \uD611\uC870 \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == consumable ? \"\uC18C\uBAA8\uD488 \uBD84\uB958\uB85C \uC785\uACE0\uD569\uB2C8\uB2E4.
      \uC18C\uC9C4 \uC608\uC0C1 \uC2DC\uC810\uC5D0 \uB9DE\uCDB0 \uBC30\uBD84 \uBAA9\uB85D\uC5D0
      \uC62C\uB9AC\uACA0\uC2B5\uB2C8\uB2E4.\" : \"\uBD84\uB958\uD45C\uC5D0 \uB9DE\uCDB0
      \uC785\uACE0\uD569\uB2C8\uB2E4.\"} \uCC98\uB9AC \uB05D\uB0AC\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{groupName}(\uC740/\uB294) \uADDC\uC815\uB300\uB85C\uB9CC \uCC98\uB9AC\uD569\uB2C8\uB2E4.
      \uC624\uB298\uC740 \uADDC\uC815\uACFC \uC22B\uC790\uAC00 \uB9DE\uC558\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{npcName}, \uC811\uC218 \uBC88\uD638 \uBD80\uC5EC\uD588\uC2B5\uB2C8\uB2E4.
      \uB2E4\uC74C \uAC74\uB3C4 \uAC19\uC740 \uAE30\uC900\uC73C\uB85C \uCC98\uB9AC\uB429\uB2C8\uB2E4."
  - speakerId: 0
    text: "{price >= baseValue ? \"\uADDC\uC815 \uB9E4\uC785\uAC00 \uC774\uC0C1\uC73C\uB85C
      \uCC98\uB9AC\uD588\uC73C\uB2C8 \uAC10\uC0AC\uC5D0\uC11C \uBB38\uC81C\uB420
      \uC77C\uC740 \uC5C6\uACA0\uC2B5\uB2C8\uB2E4.\" : \"\uADDC\uC815 \uBC94\uC704
      \uC548\uC5D0\uC11C \uCC98\uB9AC\uD588\uC73C\uB2C8 \uAC10\uC0AC\uC5D0\uC11C
      \uBB38\uC81C\uB420 \uC77C\uC740 \uC5C6\uACA0\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "\uB9C8\uAC10 \uC804\uC5D0 \uB05D\uB0AC\uAD70\uC694. \uD611\uC870 \uAC10\uC0AC\uD569\uB2C8\uB2E4."
  _rejection:
  - speakerId: 0
    text: "\uD574\uB2F9 \uAE08\uC561\uC740 \uC811\uC218 \uBD88\uAC00\uC785\uB2C8\uB2E4.
      \uC11C\uC2DD\uC744 \uB2EB\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{askPrice}\uACE8\uB4DC\uB294 \uADDC\uC815 \uC678 \uAE08\uC561\uC785\uB2C8\uB2E4.
      \uC811\uC218\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemCount > 1 ? \"{itemCount}\uAC1C \uC77C\uAD04 \uAC74\uC774\uC5B4\uB3C4
      \uADDC\uC815 \uB9E4\uC785\uAC00\uB294 \uBC14\uB00C\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\"
      : \"1\uAC1C \uAC74\uC774\uC5B4\uB3C4 \uADDC\uC815 \uB9E4\uC785\uAC00\uB294
      \uBC14\uB00C\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.\"} \uC811\uC218 \uC885\uACB0\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemName}(\uC740/\uB294) \uC785\uACE0 \uB300\uC0C1\uC774\uC9C0\uB9CC
      \uADF8 \uAE08\uC561\uC73C\uB85C\uB294 \uC2B9\uC778\uC774 \uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == consumable ? \"\uC18C\uBAA8\uD488 \uC7AC\uACE0\uAC00 \uC544\uC27D\uAE34
      \uD569\uB2C8\uB2E4. \uADF8\uB798\uB3C4 \uB2E8\uAC00\uD45C\uB97C \uBC97\uC5B4\uB0A0
      \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\" : \"\uC785\uACE0\uAC00 \uC544\uC27D\uAE34
      \uD569\uB2C8\uB2E4. \uADF8\uB798\uB3C4 \uB2E8\uAC00\uD45C\uB97C \uBC97\uC5B4\uB0A0
      \uC218\uB294 \uC5C6\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "{groupName}(\uC740/\uB294) \uADDC\uC815 \uBC16\uC758 \uB9E4\uC785\uC740
      \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uC811\uC218 \uC885\uACB0\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{npcName}(\uC740/\uB294) \uBC18\uB824 \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC7AC\uC2E0\uCCAD\uC740 \uADDC\uC815 \uB9E4\uC785\uAC00\uB85C \uAC00\uB2A5\uD569\uB2C8\uB2E4."
  - speakerId: 0
    text: "{itemType == material ? \"\uC7AC\uB8CC\uB294 \uC815\uAE30 \uB0A9\uD488\uC73C\uB85C\uB3C4
      \uCC44\uC6B8 \uC218 \uC788\uC5B4\uC11C \uBB34\uB9AC\uD560 \uC774\uC720\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4.\" : {itemType == rune ? \"\uB8EC\uC740 \uB2E4\uC74C
      \uC785\uACE0 \uC77C\uC815\uC774 \uB530\uB85C \uC788\uC5B4\uC11C \uBB34\uB9AC\uD560
      \uC774\uC720\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\" : {itemType == consumable ?
      \"\uC18C\uBAA8\uD488\uC740 \uC815\uAE30 \uBCF4\uAE09\uBD84\uC73C\uB85C \uBC84\uD2F8
      \uC218 \uC788\uC5B4\uC11C \uBB34\uB9AC\uD560 \uC774\uC720\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\"
      : \"\uB2E4\uB978 \uC785\uACE0 \uC77C\uC815\uC774 \uC788\uC5B4\uC11C \uBB34\uB9AC\uD560
      \uC774\uC720\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.\"}}}"
  - speakerId: 0
    text: "{askRatio >= 1.3 ? \"\uC774 \uAE08\uC561\uC740 \uC11C\uC2DD\uC5D0 \uC801\uB294
      \uAC83\uBD80\uD130\uAC00 \uBD88\uAC00\uB2A5\uD569\uB2C8\uB2E4. \uBC18\uB824\uD569\uB2C8\uB2E4.\"
      : \"\uADDC\uC815\uACFC \uC870\uAE08 \uC5B4\uAE0B\uB0AC\uC2B5\uB2C8\uB2E4. \uB2E4\uC74C
      \uC811\uC218 \uB54C \uB2E4\uC2DC \uBD59\uACA0\uC2B5\uB2C8\uB2E4.\"}"
  - speakerId: 0
    text: "\uB2E4\uC74C \uC811\uC218 \uAC74\uC744 \uCC98\uB9AC\uD558\uACA0\uC2B5\uB2C8\uB2E4.
      \uC774\uB9CC \uC885\uACB0\uD569\uB2C8\uB2E4."
  _minTimer: 50
  _maxTimer: 110
