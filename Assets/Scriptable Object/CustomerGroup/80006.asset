  _customerGroupTitle: "\uBB3C\uC790\uBCF4\uAE09\uAD00"
  _customerGroupName: "\uBAA8\uD5D8\uAC00 \uAE38\uB4DC \uBCF4\uAE09\uBD80\uC11C"
  _description: "\uAC70\uC810 \uC8FC\uC810\uC758 \uC6A9\uBCD1 \uAD00\uB9AC\uC778\uACFC
    \uC5F0\uACC4\uB41C \uBB3C\uC790 \uB2F4\uB2F9\uAD00. \uC0AC\uBB34\uC801\uC774\uACE0
    \uAC74\uC870\uD568. \uB2E8 1\uAC1C\uB77C\uB3C4 \uAE38\uB4DC \uADDC\uC815 \uB9E4\uC785\uAC00\uC5D0
    \uB9DE\uCDB0 \uC0AC\uACA0\uB2E4\uB294 \uAE50\uAE50\uD55C \uC0AC\uBB34\uC801 \uD1A4."
